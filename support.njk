<style>
  :root{
    --bg: #faf7f0; --card: #ffffff; --ink: #1e2530; --muted: #6c7383; --line: #ece6d8;
    --teal: #0e9594; --teal-soft: #e3f5f3; --coral: #ff6f59; --coral-soft: #ffece8;
    --gold: #f2a53c; --gold-soft: #fdf1de; --violet: #7c6ee8;
  }
  html.arw-dark{
    --bg:#0d0f13; --card:#171a20; --ink:#eef1f6; --muted:#9aa2b0; --line:rgba(255,255,255,.1);
    --teal:#1cb5b3; --teal-soft:rgba(28,181,179,.15); --coral:#ff8570; --coral-soft:rgba(255,133,112,.15);
    --gold:#f4b352; --gold-soft:rgba(244,179,82,.15); --violet:#9a8ff0;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{ scroll-behavior:smooth; background-color:var(--bg); }
  body{ background:var(--bg); color:var(--ink); font-family:'Tajawal',sans-serif; line-height:1.75; transition:background-color .3s ease, color .3s ease; }
  h1,h2,h3,.brand{ font-family:'Cairo',sans-serif; font-weight:900; }

  header{ position:sticky; top:0; z-index:50; background:var(--bg); backdrop-filter:blur(8px); border-bottom:1px solid var(--line); transition:background-color .3s ease, border-color .3s ease; }
  .nav{ max-width:1180px; margin:0 auto; padding:16px 24px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px;}
  .brand{ font-weight:900; font-size:21px; text-decoration:none; color:var(--ink); white-space:nowrap; transition:transform 0.25s ease; display:inline-flex; align-items:center; gap:10px; }
  .brand:hover{ transform:scale(1.04); }
  .brand span{ color:var(--teal); transition:color 0.25s ease; }
  .nav ul{ list-style:none; display:flex; align-items:center; gap:6px; flex-wrap:wrap; white-space:nowrap; }
  .nav ul li{ display:inline-flex; align-items:center; }
  .nav a.navlink, #navMenu a.navlink{ color:var(--ink); text-decoration:none; font-weight:700; font-size:14px; padding:9px 16px; border-radius:999px; transition:all 0.25s cubic-bezier(0.34,1.56,0.64,1); position:relative; border:1px solid transparent; }
  .nav a.navlink:hover{ background:var(--teal-soft); color:var(--teal); transform:translateY(-2px); }
  .nav a.navlink.active, #navMenu a.navlink.active{ background:#1e2530 !important; color:#fff !important; border-color:#1e2530 !important; box-shadow:0 4px 12px rgba(30,37,48,0.25) !important; }
  html.arw-dark .nav a.navlink.active, html.arw-dark #navMenu a.navlink.active{ background:#fff !important; color:#1e2530 !important; border-color:#fff !important; box-shadow:0 4px 12px rgba(255,255,255,0.2) !important; }
  .nav a.navlink.support-btn, #navMenu a.navlink.support-btn{ display:inline-flex; align-items:center; gap:6px; background:linear-gradient(135deg, var(--coral), var(--gold)); color:#fff !important; border:none; box-shadow:0 4px 14px rgba(255,111,89,0.35); animation:support-pulse 2.6s ease-in-out infinite; }
  .nav a.navlink.support-btn:hover{ background:linear-gradient(135deg, var(--gold), var(--coral)); color:#fff !important; transform:translateY(-2px) scale(1.04); box-shadow:0 8px 20px rgba(255,111,89,0.45); animation-play-state:paused; }
  .nav a.navlink.support-btn svg{ flex-shrink:0; }
  @keyframes support-pulse{ 0%,100%{ box-shadow:0 4px 14px rgba(255,111,89,0.35); } 50%{ box-shadow:0 4px 22px rgba(255,111,89,0.65); } }
  .nav-dropdown{ position:relative; display:inline-flex; align-items:center; }
  .site-search{ flex:1; min-width:140px; max-width:420px; display:flex; align-items:center; background:var(--card); border:1px solid var(--line); border-radius:999px; padding:6px 8px 6px 16px; transition:all 0.3s cubic-bezier(0.16,1,0.3,1); }
  .site-search:focus-within{ border-color:var(--teal); box-shadow:0 0 0 4px var(--teal-soft), 0 8px 24px -8px rgba(14,149,148,0.25); transform:translateY(-1px); }
  .site-search input{ flex:1; border:none; outline:none; background:transparent; font-family:'Tajawal',sans-serif; font-size:14px; color:var(--ink); padding:6px 4px; }
  .site-search input::placeholder{ color:var(--muted); }
  .site-search button{ border:none; background:var(--teal); color:#fff; width:34px; height:34px; border-radius:50%; cursor:pointer; display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:transform 0.25s cubic-bezier(0.34,1.56,0.64,1), background-color 0.2s ease; }
  .site-search button:hover{ transform:scale(1.12) rotate(8deg); background:#0b7c7b; }
  .theme-toggle{ width:40px; height:40px; border-radius:50%; border:1px solid var(--line); background:var(--card); color:var(--ink); display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0; transition:all 0.35s cubic-bezier(0.34,1.56,0.64,1); }
  .theme-toggle:hover{ transform:rotate(45deg) scale(1.1); border-color:var(--teal); color:var(--teal); }
  .theme-toggle svg{ display:block; transition:transform 0.3s ease; }
  .theme-toggle .icon-sun{ display:none; }
  html.arw-dark .theme-toggle .icon-moon{ display:none; }
  html.arw-dark .theme-toggle .icon-sun{ display:block; }
  .telegram-btn{ width:40px; height:40px; border-radius:50%; border:1px solid var(--line); background:var(--card); color:var(--ink); display:flex; align-items:center; justify-content:center; text-decoration:none; flex-shrink:0; transition:all 0.35s cubic-bezier(0.34,1.56,0.64,1); }
  .telegram-btn:hover{ transform:scale(1.1); border-color:var(--teal); color:var(--teal); }
  .utility-row{ display:inline-flex; align-items:center; gap:8px; }

  /* ==== محتوى صفحة الدعم ==== */
  .support-hero{ position:relative; padding:90px 24px 70px; text-align:center; overflow:hidden; background: linear-gradient(150deg, rgba(255,111,89,.92), rgba(242,165,60,.92)); }
  .support-hero-icon{ width:70px; height:70px; margin:0 auto 22px; border-radius:50%; background:rgba(255,255,255,.18); backdrop-filter:blur(6px); display:flex; align-items:center; justify-content:center; color:#fff; box-shadow:0 10px 30px rgba(0,0,0,0.15); }
  .support-hero h1{ color:#fff; font-size:clamp(28px,4.6vw,42px); margin-bottom:14px; text-shadow:0 4px 20px rgba(0,0,0,.2); }
  .support-hero p{ color:rgba(255,255,255,.95); font-size:16.5px; max-width:600px; margin:0 auto; }

  .support-wrap{ max-width:820px; margin:0 auto; padding:56px 24px 80px; }
  .support-card{ background:var(--card); border:1px solid var(--line); border-radius:20px; padding:32px; margin-bottom:24px; box-shadow:0 8px 24px -14px rgba(0,0,0,.12); }
  .support-card h2{ font-size:20px; margin-bottom:14px; display:flex; align-items:center; gap:10px; }
  .support-card h2 .dot{ width:9px; height:9px; border-radius:50%; background:var(--coral); flex-shrink:0; }
  .support-card p{ color:var(--muted); font-size:15px; margin-bottom:10px; }
  .support-card p:last-child{ margin-bottom:0; }

  .support-reasons{ display:grid; grid-template-columns:repeat(2,1fr); gap:16px; margin-top:18px; }
  @media (max-width:600px){ .support-reasons{ grid-template-columns:1fr; } }
  .reason-item{ display:flex; align-items:flex-start; gap:12px; background:var(--bg); border:1px solid var(--line); border-radius:14px; padding:16px; }
  .reason-item .icon{ width:36px; height:36px; border-radius:10px; background:var(--teal-soft); color:var(--teal); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .reason-item h3{ font-size:14.5px; font-weight:800; margin-bottom:4px; }
  .reason-item p{ font-size:13px; color:var(--muted); margin:0; }

  .support-cta{ text-align:center; background:linear-gradient(150deg, var(--coral-soft), var(--gold-soft)); border:1px solid var(--line); border-radius:22px; padding:44px 28px; }
  .support-cta h2{ font-size:22px; margin-bottom:10px; }
  .support-cta p{ color:var(--muted); font-size:15px; margin-bottom:26px; max-width:480px; margin-inline:auto; }
  .fawaterk-btn{ display:inline-flex; align-items:center; gap:10px; background:linear-gradient(135deg, var(--coral), var(--gold)); color:#fff; text-decoration:none; font-weight:800; font-size:17px; padding:16px 36px; border-radius:999px; box-shadow:0 10px 26px rgba(255,111,89,0.4); transition:all 0.3s cubic-bezier(0.34,1.56,0.64,1); }
  .fawaterk-btn:hover{ transform:translateY(-4px) scale(1.03); box-shadow:0 16px 34px rgba(255,111,89,0.5); }
  .fawaterk-note{ margin-top:16px; font-size:12.5px; color:var(--muted); }

  .support-faq details{ background:var(--bg); border:1px solid var(--line); border-radius:14px; padding:16px 18px; margin-bottom:10px; }
  .support-faq details:last-child{ margin-bottom:0; }
  .support-faq summary{ cursor:pointer; font-weight:800; font-size:14.5px; list-style:none; display:flex; align-items:center; justify-content:space-between; }
  .support-faq summary::-webkit-details-marker{ display:none; }
  .support-faq summary::after{ content:'+'; font-size:20px; color:var(--muted); transition:transform 0.25s ease; }
  .support-faq details[open] summary::after{ transform:rotate(45deg); }
  .support-faq details p{ margin-top:10px; color:var(--muted); font-size:13.5px; }

  footer{ padding:40px 24px; text-align:center; color:var(--muted); font-size:13px; border-top:1px solid var(--line); }
  .social-row{ display:flex; justify-content:center; gap:12px; margin-bottom:16px; }
  .social-row a{ width:38px; height:38px; border-radius:50%; background:var(--card); border:1px solid var(--line); display:flex; align-items:center; justify-content:center; color:var(--ink); transition:all 0.3s cubic-bezier(0.34,1.56,0.64,1); }
  .social-row a:hover{ background:var(--teal); color:#fff; border-color:var(--teal); transform:translateY(-4px) scale(1.12); box-shadow:0 8px 16px rgba(14,149,148,0.3); }

  /* ===== Mobile Navigation: everything visible, wraps neatly, no scrolling ===== */
  @media (max-width:860px){
    .nav{ padding:14px 16px 16px; gap:10px; flex-wrap:wrap; justify-content:center; }
    .brand{ font-size:19px; flex-basis:auto; }
    .site-search{ order:2; flex-basis:100%; max-width:none; min-width:0; }
    #navMenu{
      order:3; flex-basis:100%; width:100%;
      display:flex; flex-wrap:wrap; align-items:center; justify-content:center;
      gap:8px 8px; padding-top:2px;
    }
    #navMenu li{ display:inline-flex; }
    #navMenu a.navlink{ font-size:13px; padding:8px 14px; }
    #navMenu .nav-dropdown{ display:inline-flex; }
    #navMenu .dropdown-menu{ display:none !important; } /* hover menus don't work on touch; tapping "الاتحادات" opens /federations/ directly */
    #navMenu li.utility-row{ display:inline-flex; }
    #navMenu .theme-toggle, #navMenu .telegram-btn{ width:38px; height:38px; }
  }
  .reveal{ opacity:1; transform:none; }
  .reveal.reveal-hidden{ opacity:0; transform:translateY(16px); transition:none !important; }
  .reveal.is-visible{ opacity:1; transform:translateY(0); transition:opacity .45s cubic-bezier(.16,1,.3,1), transform .45s cubic-bezier(.16,1,.3,1); }
</style>
