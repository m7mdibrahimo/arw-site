<style>
:root{
--bg: #faf7f0; --card: #ffffff; --ink: #1e2530; --muted: #6c7383; --line: #ece6d8;
--teal: #0e9594; --teal-soft: #e3f5f3; --coral: #ff6f59; --coral-soft: #ffece8;
--gold: #f2a53c; --gold-soft: #fdf1de; --violet: #7c6ee8;
--nostalgia: #0284c7; --nostalgia-soft: #e0f2fe;
}
html.arw-dark{
--bg:#0d0f13; --card:#171a20; --ink:#eef1f6; --muted:#9aa2b0; --line:rgba(255,255,255,.1);
--teal:#1cb5b3; --teal-soft:rgba(28,181,179,.15); --coral:#ff8570; --coral-soft:rgba(255,133,112,.15);
--gold:#f4b352; --gold-soft:rgba(244,179,82,.15); --violet:#9a8ff0;
--nostalgia: #38bdf8; --nostalgia-soft: rgba(56,189,248,.15);
}
*{box-sizing:border-box; margin:0; padding:0; -webkit-text-size-adjust:100%; text-size-adjust:100%;}
html{ scroll-behavior:smooth; background-color:var(--bg); -webkit-text-size-adjust:100%; -moz-text-size-adjust:100%; text-size-adjust:100%; -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale; text-rendering:optimizeLegibility; }
body{ background:var(--bg); color:var(--ink); font-family:'Tajawal',sans-serif; line-height:1.75; transition:background-color .3s ease, color .3s ease; -webkit-text-size-adjust:100%; -moz-text-size-adjust:100%; text-size-adjust:100%; }
.show-card:active, .news-card:active, .fed-card:active, .btn:active, .qn:active, .tag-pill:active, .tag-card:active, .social-row a:active {
transform: scale(0.97) translateY(0) !important;
transition: transform 0.08s ease !important;
}
h1,h2,h3,.brand{ font-family:'Cairo',sans-serif; font-weight:900; }
header{ position:sticky; top:0; z-index:50; background:var(--bg); backdrop-filter:blur(8px); border-bottom:1px solid var(--line); transition:background-color .3s ease, border-color .3s ease, transform .3s ease; }
header.header-hidden{ transform:translateY(-100%); }
.nav{ max-width:1440px; margin:0 auto; padding:15px 20px; display:flex; align-items:center; justify-content:center; flex-wrap:nowrap; gap:16px;}
.brand{ font-weight:900; font-size:22px; text-decoration:none; color:var(--ink); white-space:nowrap; transition:transform 0.25s ease; display:inline-flex; align-items:center; gap:9px; flex-shrink:0; }
.brand img.brand-logo{ width:40px; height:40px; object-fit:contain; border-radius:10px; filter:drop-shadow(0 2px 6px rgba(0,0,0,0.25)); transition:transform 0.3s ease; }
.brand:hover img.brand-logo{ transform:rotate(6deg) scale(1.08); }
.brand:hover{ transform:scale(1.04); }
.brand span{ color:var(--teal); transition:color 0.25s ease; }
.nav ul{ list-style:none; display:flex; align-items:center; gap:5px; flex-wrap:nowrap; white-space:nowrap; flex-shrink:0; }
.nav ul li{ display:inline-flex; align-items:center; }
.nav a.navlink, #navMenu a.navlink{ color:var(--ink); text-decoration:none; font-weight:700; font-size:15px; padding:9px 15px; border-radius:999px; transition:all 0.25s cubic-bezier(0.34,1.56,0.64,1); position:relative; border:1px solid transparent; }
.nav a.navlink:hover{ background:var(--teal-soft); color:var(--teal); transform:translateY(-2px); }
.nav a.navlink.active, #navMenu a.navlink.active{ background:#1e2530 !important; color:#fff !important; border-color:#1e2530 !important; box-shadow:0 4px 12px rgba(30,37,48,0.25) !important; }
.nav a.navlink.support-btn, #navMenu a.navlink.support-btn{ display:inline-flex; align-items:center; gap:7px; background:linear-gradient(135deg, var(--coral), var(--gold)); color:#fff !important; border:none; padding:9px 17px; font-size:15px; box-shadow:0 4px 14px rgba(255,111,89,0.35); animation:support-pulse 2.6s ease-in-out infinite; }
.nav a.navlink.support-btn:hover{ background:linear-gradient(135deg, var(--gold), var(--coral)); color:#fff !important; transform:translateY(-2px) scale(1.04); box-shadow:0 8px 20px rgba(255,111,89,0.45); animation-play-state:paused; }
.nav a.navlink.support-btn svg{ flex-shrink:0; width:17px; height:17px; }
@keyframes support-pulse{ 0%,100%{ box-shadow:0 4px 14px rgba(255,111,89,0.35); } 50%{ box-shadow:0 4px 22px rgba(255,111,89,0.65); } }
html.arw-dark .nav a.navlink.active, html.arw-dark #navMenu a.navlink.active{ background:#fff !important; color:#1e2530 !important; border-color:#fff !important; box-shadow:0 4px 12px rgba(255,255,255,0.2) !important; }
.nav-dropdown{ position:relative; display:inline-flex; align-items:center; }
.dropdown-menu{ display:flex !important; flex-direction:column; gap:4px !important; position:absolute; top:calc(100% + 6px); left:50%; right:auto; transform:translateX(-50%) translateY(-6px) scale(0.97); min-width:185px; background:var(--card); border:1px solid var(--line); border-radius:14px; padding:8px; box-shadow:0 16px 36px -12px rgba(0,0,0,.25); list-style:none; opacity:0; visibility:hidden; transition:all 0.22s cubic-bezier(0.16,1,0.3,1); z-index:60; transform-origin:top center; pointer-events:none; }
.dropdown-menu::before{ content:''; position:absolute; top:-14px; left:0; right:0; height:14px; background:transparent; display:block; }
.nav-dropdown:hover .dropdown-menu, .nav-dropdown:focus-within .dropdown-menu{ opacity:1; visibility:visible; transform:translateX(-50%) translateY(0) scale(1); pointer-events:auto; }
.dropdown-menu li{ list-style:none; width:100%; margin:0; padding:0; }
.dropdown-menu a.drop-item{ display:flex; align-items:center; gap:10px; width:100%; box-sizing:border-box; padding:10px 14px; border-radius:10px; color:var(--ink); text-decoration:none; font-weight:800; font-size:14.5px; border:1px solid transparent; transition:all 0.2s cubic-bezier(0.16,1,0.3,1); }
.drop-dot{ width:9px; height:9px; border-radius:50%; flex-shrink:0; transition:transform 0.2s ease; }
.drop-item:hover .drop-dot{ transform:scale(1.4); }
.drop-wwe .drop-dot{ background:#c73b2c; }
.drop-wwe:hover, .drop-wwe.active{ background:rgba(199,59,44,.12) !important; color:#c73b2c !important; border-color:rgba(199,59,44,.25) !important; transform:translateX(-3px); }
.drop-aew .drop-dot{ background:#d4a017; }
.drop-aew:hover, .drop-aew.active{ background:rgba(212,160,23,.15) !important; color:#b58509 !important; border-color:rgba(212,160,23,.3) !important; transform:translateX(-3px); }
.drop-tna .drop-dot{ background:#8a5fe0; }
.drop-tna:hover, .drop-tna.active{ background:rgba(138,95,224,.14) !important; color:#7c42d6 !important; border-color:rgba(138,95,224,.28) !important; transform:translateX(-3px); }
.drop-roh .drop-dot{ background:#3866c7; }
.drop-roh:hover, .drop-roh.active{ background:rgba(44,102,199,.14) !important; color:#2358b5 !important; border-color:rgba(44,102,199,.28) !important; transform:translateX(-3px); }
.drop-mma .drop-dot{ background:#e07a2c; }
.drop-mma:hover, .drop-mma.active{ background:rgba(224,122,44,.14) !important; color:#c45b10 !important; border-color:rgba(224,122,44,.28) !important; transform:translateX(-3px); }
.drop-indie .drop-dot{ background:#1f8a72; }
.drop-indie:hover, .drop-indie.active{ background:rgba(31,138,114,.14) !important; color:#0f705b !important; border-color:rgba(31,138,114,.28) !important; transform:translateX(-3px); }
html.arw-dark .drop-wwe:hover, html.arw-dark .drop-wwe.active{ background:rgba(225,75,60,.2) !important; color:#ff6b5b !important; border-color:rgba(225,75,60,.35) !important; }
html.arw-dark .drop-aew:hover, html.arw-dark .drop-aew.active{ background:rgba(240,195,60,.2) !important; color:#f4b352 !important; border-color:rgba(240,195,60,.35) !important; }
html.arw-dark .drop-tna:hover, html.arw-dark .drop-tna.active{ background:rgba(155,109,240,.2) !important; color:#b18cff !important; border-color:rgba(155,109,240,.35) !important; }
html.arw-dark .drop-roh:hover, html.arw-dark .drop-roh.active{ background:rgba(70,130,240,.2) !important; color:#60a5fa !important; border-color:rgba(70,130,240,.35) !important; }
html.arw-dark .drop-mma:hover, html.arw-dark .drop-mma.active{ background:rgba(240,140,60,.2) !important; color:#ff9d5c !important; border-color:rgba(240,140,60,.35) !important; }
html.arw-dark .drop-indie:hover, html.arw-dark .drop-indie.active{ background:rgba(40,180,150,.2) !important; color:#34d399 !important; border-color:rgba(40,180,150,.35) !important; }
.site-search{ flex:0 1 400px; width:400px; max-width:460px; min-width:260px; display:flex; align-items:center; background:var(--card); border:1px solid var(--line); border-radius:999px; padding:5px 6px 5px 14px; transition:all 0.3s cubic-bezier(0.16,1,0.3,1); }
.site-search:focus-within{ border-color:var(--teal); box-shadow:0 0 0 4px var(--teal-soft), 0 8px 24px -8px rgba(14,149,148,0.25); transform:translateY(-1px); }
.site-search input{ flex:1; border:none; outline:none; background:transparent; font-family:'Tajawal',sans-serif; font-size:14.5px; color:var(--ink); padding:6px 4px; }
.site-search input::placeholder{ color:var(--muted); font-size:14px; }
.site-search button{ border:none; background:var(--teal); color:#fff; width:36px; height:36px; border-radius:50%; cursor:pointer; display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:transform 0.25s cubic-bezier(0.34,1.56,0.64,1), background-color 0.2s ease; }
.site-search button svg{ width:17px; height:17px; }
.site-search button:hover{ transform:scale(1.12) rotate(8deg); background:#0b7c7b; }
.site-search button:active{ transform:scale(0.95); }
.theme-toggle{ width:40px; height:40px; border-radius:50%; border:1px solid var(--line); background:var(--card); color:var(--ink); display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0; transition:all 0.35s cubic-bezier(0.34,1.56,0.64,1); }
.theme-toggle:hover{ transform:rotate(45deg) scale(1.1); border-color:var(--teal); color:var(--teal); }
.theme-toggle:active{ transform:rotate(180deg) scale(0.9); }
.theme-toggle svg{ display:block; transition:transform 0.3s ease; }
.theme-toggle .icon-sun{ display:none; }
html.arw-dark .theme-toggle .icon-moon{ display:none; }
html.arw-dark .theme-toggle .icon-sun{ display:block; }
.telegram-btn{ width:40px; height:40px; border-radius:50%; border:1px solid var(--line); background:var(--card); color:var(--ink); display:flex; align-items:center; justify-content:center; text-decoration:none; flex-shrink:0; transition:all 0.35s cubic-bezier(0.34,1.56,0.64,1); }
.telegram-btn:hover{ transform:scale(1.1); border-color:var(--teal); color:var(--teal); }
.utility-row{ display:inline-flex; align-items:center; gap:8px; flex-shrink:0; }
.utility-row .support-btn{ order:1; }
.utility-row .theme-toggle{ order:2; }
.utility-row .telegram-btn{ order:3; }
.telegram-btn:active{ transform:scale(0.92); }
.page-head{ padding:56px 24px 36px; text-align:center; border-bottom:1px solid var(--line); }
.page-head h1{ font-size:clamp(26px,4vw,36px); margin-bottom:8px; }
.page-head p{ color:var(--muted); font-size:14.5px; }
section.content{ padding:40px 24px 70px; }
.wrap{ max-width:1180px; margin:0 auto; }
.grid-12{ display:grid; grid-template-columns:repeat(12,1fr); gap:20px; }
.grid-12 > *{ grid-column:span 3; }
@media (max-width:900px){ .grid-12 > *{ grid-column:span 6; } }
@media (max-width:560px){ .grid-12 > *{ grid-column:span 6; } }
.feds-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:20px; }
@media (max-width:700px){ .feds-grid{ grid-template-columns:repeat(2,1fr); } }
@media (max-width:420px){ .feds-grid{ grid-template-columns:repeat(2,1fr); } }
/* Federation Cards & Animations */
.fed-card{ display:block; text-decoration:none; color:var(--ink); background:var(--card); border:1px solid var(--line); border-radius:18px; overflow:hidden; transition:transform 0.35s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.35s ease, border-color 0.3s ease; box-shadow:0 6px 16px -12px rgba(30,37,48,.15); position:relative; }
.fed-card:hover{ transform:translateY(-8px) scale(1.02); box-shadow:0 20px 36px -16px rgba(14,149,148,.3); border-color:var(--teal); }
.fed-mark{ height:110px; display:flex; align-items:center; justify-content:center; font-family:'Cairo',sans-serif; font-weight:900; font-size:28px; color:#fff; transition:transform 0.4s ease; }
.fed-card:hover .fed-mark{ transform:scale(1.06); }
.fed-wwe .fed-mark{ background:linear-gradient(135deg,#c73b2c,#8f2015); }
.fed-aew .fed-mark{ background:linear-gradient(135deg,#e0b93c,#a87c14); }
.fed-tna .fed-mark{ background:linear-gradient(135deg,#8a5fe0,#5a35a6); }
.fed-roh .fed-mark{ background:linear-gradient(135deg,#3866c7,#1d3a80); }
.fed-mma .fed-mark{ background:linear-gradient(135deg,#e07a2c,#a34d10); }
.fed-indie .fed-mark{ background:linear-gradient(135deg,#1f8a72,#0f5245); }
.fed-card .info{ padding:16px 18px; text-align:center; }
.fed-card p{ color:var(--muted); font-size:13px; }
/* Show Cards Animations */
.show-card{ background:var(--card); border:1px solid var(--line); border-radius:16px; overflow:hidden; transition:transform 0.35s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.35s ease, border-color 0.3s ease; display:block; text-decoration:none; color:var(--ink); }
.show-card:hover{ transform:translateY(-8px) scale(1.015); box-shadow:0 20px 36px -16px rgba(14,149,148,.28); border-color:var(--teal); }
.show-thumb{ height:160px; background-size:cover; background-position:center; display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden; transition:transform 0.6s cubic-bezier(0.25,1,0.5,1); }
.show-card:hover .show-thumb{ transform:scale(1.07); }
.show-thumb::before{ content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(0,0,0,.05), rgba(0,0,0,.45)); transition:opacity 0.3s ease; }
.play-btn{ z-index:1; width:48px; height:48px; border-radius:50%; background:rgba(30,37,48,0.85); color:#fff; display:flex; align-items:center; justify-content:center; backdrop-filter:blur(4px); box-shadow:0 4px 14px rgba(0,0,0,0.3); transition:all 0.35s cubic-bezier(0.34,1.56,0.64,1); }
@keyframes playPulse {
0% { box-shadow: 0 0 0 0 rgba(14, 149, 148, 0.7); }
70% { box-shadow: 0 0 0 16px rgba(14, 149, 148, 0); }
100% { box-shadow: 0 0 0 0 rgba(14, 149, 148, 0); }
}
.show-card:hover .play-btn{ transform:scale(1.18); background:var(--teal); animation: playPulse 1.5s infinite; }
.show-body{ padding:18px 20px; }
.show-body .ep{ font-size:11.5px; color:var(--gold); font-weight:800; letter-spacing:.5px; }
.show-body h3{ font-size:15.5px; font-weight:700; margin:6px 0 8px; transition:color 0.2s ease; line-height:1.45; }
.show-card:hover .show-body h3{ color:var(--teal); }
.show-body .desc{ color:var(--muted); font-size:13px; margin-bottom:12px; }
.show-body .foot{ display:flex; justify-content:flex-start; font-size:12px; color:var(--muted); border-top:1px solid var(--line); padding-top:10px; }
/* News Cards Animations */
.news-card{ background:var(--card); border:1px solid var(--line); border-radius:16px; overflow:hidden; transition:transform 0.35s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.35s ease, border-color 0.3s ease; display:block; text-decoration:none; color:var(--ink); }
.news-card:hover{ transform:translateY(-8px) scale(1.015); box-shadow:0 20px 36px -16px rgba(255,111,89,.28); border-color:var(--coral); }
.news-thumb{ height:160px; background-size:cover; background-position:center; position:relative; overflow:hidden; transition:transform 0.6s cubic-bezier(0.25,1,0.5,1); }
.news-card:hover .news-thumb{ transform:scale(1.07); }
.news-thumb::before{ content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(0,0,0,.05), rgba(0,0,0,.35)); }
.news-body{ padding:18px 20px; }
.news-body .date{ display:block; color:var(--muted); font-size:12px; border-top:1px solid var(--line); padding-top:10px; margin-top:10px; }
.kind-badge{ display:inline-flex; align-items:center; font-size:10.5px; font-weight:800; padding:3px 10px; border-radius:999px; margin-inline-end:6px; margin-bottom:8px; vertical-align:middle; transition:transform 0.2s ease; }
.cat, .fed-badge{ display:inline-flex; align-items:center; font-size:10.5px; font-weight:800; padding:3px 10px; border-radius:999px; background:var(--teal-soft); color:var(--teal); margin-bottom:8px; vertical-align:middle; transition:transform 0.2s ease, background-color 0.2s ease, color 0.2s ease; }
.cat-wwe { background: rgba(199, 59, 44, 0.12) !important; color: #c73b2c !important; }
.cat-aew { background: rgba(212, 160, 23, 0.14) !important; color: #9e7506 !important; }
.cat-tna { background: rgba(138, 95, 224, 0.14) !important; color: #7c42d6 !important; }
.cat-roh { background: rgba(44, 102, 199, 0.14) !important; color: #2358b5 !important; }
.cat-mma { background: rgba(224, 122, 44, 0.14) !important; color: #c45b10 !important; }
.cat-indie { background: rgba(31, 138, 114, 0.14) !important; color: #0f705b !important; }
html.arw-dark .cat-wwe { background: rgba(225, 75, 60, 0.2) !important; color: #ff6b5b !important; }
html.arw-dark .cat-aew { background: rgba(240, 195, 60, 0.2) !important; color: #f4b352 !important; }
