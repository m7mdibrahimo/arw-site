    <a href="#news" class="qn"><span class="dot" style="background:var(--coral)"></span>آخر الأخبار</a>
  </div>
</div>
<section class="content" id="feds">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="head-text"><h2 style="color:var(--teal);"><span class="dot" style="background:var(--teal)"></span>الاتحادات</h2></div>
    </div>
    <div class="feds-grid">
      <a href="/federation/wwe/" class="fed-card fed-wwe"><div class="fed-mark">WWE</div><div class="info"><p>World Wrestling Entertainment</p></div></a>
      <a href="/federation/aew/" class="fed-card fed-aew"><div class="fed-mark">AEW</div><div class="info"><p>All Elite Wrestling</p></div></a>
      <a href="/federation/tna/" class="fed-card fed-tna"><div class="fed-mark">TNA</div><div class="info"><p>Total Nonstop Action Wrestling</p></div></a>
      <a href="/federation/roh/" class="fed-card fed-roh"><div class="fed-mark">ROH</div><div class="info"><p>Ring of Honor</p></div></a>
      <a href="/federation/mma/" class="fed-card fed-mma"><div class="fed-mark">MMA</div><div class="info"><p>رياضات القتال المختلطة</p></div></a>
      <a href="/federation/indie/" class="fed-card fed-indie"><div class="fed-mark">INDIE</div><div class="info"><p>الاتحادات المستقلة</p></div></a>
    </div>
  </div>
</section>
<section class="content" id="full-shows" style="background:var(--card); border-top:1px solid var(--line); border-bottom:1px solid var(--line);">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="head-text"><h2 style="color:var(--gold);"><span class="dot" style="background:var(--gold)"></span>عروض المصارعة</h2><p>العروض الكاملة مترجمة بالعربية</p></div>
      <a href="/shows/" class="view-all">جميع العروض ←</a>
    </div>
    <div class="grid-12">
    {% for item in collections.shows %}
      {% if loop.index <= 8 %}
      <a class="show-card reveal" href="{{ item.url }}">
        <div class="show-thumb" style="background-image:url('{% optImg item.data.image, 'https://images.unsplash.com/photo-1563844528129-067e06a638e5?w=800&auto=format&fit=crop' %}')"><div class="play-btn"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" style="margin-right:-2px;"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86a1 1 0 0 0-1.5.86z"/></svg></div></div>
        <div class="show-body">
          <span class="kind-badge kind-show">عرض</span>{% if item.data.federation %}<span class="cat cat-{{ item.data.federation | lower }}">{{ item.data.federation }}</span>{% endif %}
          <h3>{{ item.data.headline or item.data.title }}</h3>
          {% if item.data.description %}<p class="desc">{{ item.data.description }}</p>{% endif %}
          <div class="foot"><span>{{ (item.data.event_date or item.date) | date }}</span>{% if item.data.duration %}<span style="margin-inline-start:auto; display:inline-flex; align-items:center; gap:3px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>{{ item.data.duration }}</span>{% endif %}</div>
        </div>
      </a>
      {% endif %}
    {% endfor %}
    </div>
  </div>
</section>
<section class="content" id="recaps">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="head-text"><h2 style="color:var(--violet);"><span class="dot" style="background:var(--violet)"></span>ملخصات العروض</h2><p>أبرز اللقطات والنتائج، لمن لا يستطيع مشاهدة الحلقة كاملة.</p></div>
      <a href="/recaps/" class="view-all">جميع الملخصات ←</a>
    </div>
    <div class="grid-12">
    {% for item in collections.recaps %}
      {% if loop.index <= 8 %}
      <a class="show-card reveal" href="{{ item.url }}">
        <div class="show-thumb" style="background-image:url('{% optImg item.data.image, 'https://images.unsplash.com/photo-1715149721511-8e48fc0cb2f4?w=800&auto=format&fit=crop' %}')"><div class="play-btn"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" style="margin-right:-2px;"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86a1 1 0 0 0-1.5.86z"/></svg></div></div>
        <div class="show-body">
          <span class="kind-badge kind-recap">ملخص</span>{% if item.data.federation %}<span class="cat cat-{{ item.data.federation | lower }}">{{ item.data.federation }}</span>{% endif %}
          <h3>{{ item.data.headline or item.data.title }}</h3>
          <p class="desc">{{ item.data.description }}</p>
          <div class="foot"><span>{{ (item.data.event_date or item.date) | date }}</span>{% if item.data.duration %}<span style="margin-inline-start:auto; display:inline-flex; align-items:center; gap:3px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>{{ item.data.duration }}</span>{% endif %}</div>
        </div>
      </a>
      {% endif %}
    {% endfor %}
    </div>
  </div>
</section>
<section class="content" id="news" style="background:var(--coral-soft);">
  <div class="wrap">
    <div class="section-head reveal">
      <div class="head-text"><h2 style="color:var(--coral);"><span class="dot" style="background:var(--coral)"></span>آخر الأخبار</h2><p>أبرز الانتقالات والإصابات والقرارات الإدارية.</p></div>
      <a href="/news/" class="view-all">جميع الأخبار ←</a>
    </div>
    <div class="grid-12">
    {% for item in collections.news %}
      {% if loop.index <= 8 %}
      <a class="news-card reveal" href="{{ item.url }}" style="display:block; text-decoration:none; color:inherit;">
        <div class="news-thumb{% if item.data.breaking %} breaking{% endif %}" style="background-image:url('{% optImg item.data.image, 'https://images.unsplash.com/photo-1543429294-fc2d8c7be842?w=900&auto=format&fit=crop' %}')"></div>
        <div class="news-body">
          <span class="kind-badge kind-news">خبر</span>{% if item.data.federation %}<span class="cat cat-{{ item.data.federation | lower }}">{{ item.data.federation }}</span>{% endif %}
          <h3>{{ item.data.title }}</h3>
          <span class="date">{{ item.date | date("dd MMM") }}</span>
        </div>
      </a>
      {% endif %}
    {% endfor %}
    </div>
  </div>
</section>
<footer>
  <div class="social-row">
    <a aria-label="فيسبوك" href="#" target="_blank"><svg fill="currentColor" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.17 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.77 8.44-4.94 8.44-9.94Z"/></svg></a>
    <a aria-label="إنستجرام" href="#" target="_blank"><svg fill="none" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><rect height="18" rx="5" stroke="currentColor" stroke-width="2" width="18" x="3" y="3"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" fill="currentColor" r="1.2"/></svg></a>
    <a aria-label="تيليجرام" href="#" target="_blank"><svg fill="currentColor" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><path d="M22 2 2 10.4l6.6 2.2L11 20l3.4-4.2L19.5 19 22 2Zm-3.1 3.3-9.8 6.4-.5 3.7 2-3.6 8.3-6.5Z"/></svg></a>
  </div>
  © 2026 عرب راسلنج — موقع عربي مستقل غير تابع لأي اتحاد رسمي.
</footer>

<script>
  if('IntersectionObserver' in window){
    const io = new IntersectionObserver((entries)=>{
      entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('is-visible'); io.unobserve(e.target);} });
    }, { threshold:.08 });
    document.querySelectorAll('.reveal').forEach(el=>{
      const rect = el.getBoundingClientRect();
      if(rect.top < (window.innerHeight || document.documentElement.clientHeight)){
        el.classList.add('is-visible');
      } else {
        el.classList.add('reveal-hidden');
        io.observe(el);
      }
    });
  }
</script>
<script>
  (function(){
    var saved = null;
    try{ saved = localStorage.getItem('arw-theme'); }catch(e){}
    if(saved !== 'dark' && saved !== 'light'){
      try{
        var m = document.cookie.match(/(?:^|; )arw-theme=([^;]*)/);
        if(m) saved = decodeURIComponent(m[1]);
      }catch(e){}
    }
    if(saved === 'dark'){ document.documentElement.classList.add('arw-dark'); }
  })();
  var themeBtn = document.getElementById('arwThemeToggle');
  if(themeBtn){
    themeBtn.addEventListener('click', function(){
      var isDark = document.documentElement.classList.toggle('arw-dark');
      var val = isDark ? 'dark' : 'light';
      try{ localStorage.setItem('arw-theme', val); }catch(e){}
      document.cookie = 'arw-theme=' + val + ';path=/;max-age=31536000';
    });
  }

  (function(){
    var prefetched = new Set();
    function prefetch(url) {
      if(!url || prefetched.has(url) || url.startsWith('#') || (url.startsWith('http') && !url.includes(location.hostname))) return;
      prefetched.add(url);
      var link = document.createElement('link');
      link.rel = 'prefetch';
      link.href = url;
      document.head.appendChild(link);
    }
    document.addEventListener('mouseover', function(e){
      var a = e.target.closest && e.target.closest('a');
      if(a && a.href && a.origin === location.origin) prefetch(a.href);
    }, { passive: true });
    document.addEventListener('touchstart', function(e){
      var a = e.target.closest && e.target.closest('a');
      if(a && a.href && a.origin === location.origin) prefetch(a.href);
    }, { passive: true });
  })();

  (function(){
    try {
      var vId = localStorage.getItem('arw_vid');
      if(!vId){
        vId = 'v_' + Math.random().toString(36).substr(2,9);
        localStorage.setItem('arw_vid', vId);
      }
      var p = window.location.pathname;
      var t = document.title;
      fetch('/api/analytics/ping?path=' + encodeURIComponent(p) + '&title=' + encodeURIComponent(t) + '&vid=' + vId, { keepalive: true }).catch(function(){});
    } catch(e) {}
  })();
</script>
</body>
</html>
