.show-card:hover .kind-badge, .news-card:hover .kind-badge, .show-card:hover .cat, .news-card:hover .cat, .show-card:hover .fed-badge, .news-card:hover .fed-badge{ transform:scale(1.06); }
.kind-show{ background:var(--gold-soft); color:#b45309; }
html.arw-dark .kind-show{ background:var(--gold-soft); color:var(--gold); }
.kind-program{ background:var(--teal-soft); color:var(--teal); }
.kind-series{ background:rgba(37,99,235,0.12); color:#1d4ed8; }
html.arw-dark .kind-series{ background:rgba(59,130,246,0.18); color:#60a5fa; }
.kind-recap{ background:rgba(124,110,232,.15); color:var(--violet); }
.kind-news{ background:var(--coral-soft); color:var(--coral); }
