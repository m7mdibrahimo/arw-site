{% if pinned and pinned.length > 0 %}
<section class="spotlight-section" id="spotlight-wrap">
<div class="wrap">
<div class="spotlight-container reveal is-visible" id="spotlightHero" data-slide-count="{{ pinned.length }}">
<!-- Dynamic Ambient Background Glow -->
<div class="spotlight-ambient-glow glow-{{ (pinned[0].federation or 'wwe') | lower }}" id="spotlightAmbientGlow"></div>

<!-- Slides Viewport -->
<div class="spotlight-viewport" id="spotlightViewport">
  {% for item in pinned %}
  {% set fedLower = (item.federation or "wwe") | lower %}
  <div class="spotlight-slide {% if loop.first %}active{% endif %}" data-index="{{ loop.index0 }}" data-fed="{{ fedLower }}">
    <!-- Full-Bleed Background Image (Anchored Left) -->
    <div class="spotlight-bg-wrap">
      <img src="{% optImg item.image, '/content/images/jtct9rkqmcshcyh6.jpg' %}" alt="{{ item.title }}" loading="{% if loop.first %}eager{% else %}lazy{% endif %}" class="spotlight-bg-img" />
      <div class="spotlight-gradient-overlay"></div>
    </div>
    
    {% if item.kind == 'show' or item.kind == 'recap' %}
    <div class="spotlight-play-float" title="مشاهدة العرض">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" style="margin-right:-2px;"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86a1 1 0 0 0-1.5.86z"/></svg>
    </div>
    {% endif %}

    <!-- Entire Card Clickable Link -->
    <a href="{{ item.url | cleanUrl }}" class="spotlight-card-link" aria-label="{{ item.title }}"></a>

    <!-- Hero Text & Content (Right in RTL) -->
    <div class="spotlight-content">
      <div class="spotlight-badges">
        <span class="spotlight-pill fed-pill-{{ fedLower }}">{{ item.federation or "WWE" }}</span>
        <span class="spotlight-pill type-pill">{{ item.kindLabel or "خبر" }}</span>
        {% if item.badge and ('مثبت' not in item.badge) %}
        <span class="spotlight-pill custom-badge">{{ item.badge }}</span>
        {% endif %}
      </div>

      {% set showSub = item.subtitle %}
      {% if not showSub and (item.kind == 'show' or item.kindLabel == 'عرض كامل' or item.kindLabel == 'عرض') %}
        {% for s in collections.shows %}
          {% if (s.url | cleanUrl) == (item.url | cleanUrl) %}
            {% if s.data.headline and s.data.title and s.data.headline != s.data.title %}
              {% set showSub = s.data.title %}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}

      <div class="spotlight-title-group">
        <h2 class="spotlight-title">
          <span class="spotlight-title-text">{{ item.title }}</span>
        </h2>
        {% if (item.kind == 'show' or item.kindLabel == 'عرض كامل' or item.kindLabel == 'عرض') and showSub %}
        <div class="spotlight-subtitle" dir="ltr">{{ showSub }}</div>
        {% endif %}
      </div>

      <div class="spotlight-actions">
        <span class="spotlight-cta-btn">
          <span>{% if item.kind == 'show' or item.kind == 'recap' %}شاهد العرض الآن{% else %}اقرأ التفاصيل كاملة{% endif %}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        </span>
      </div>
    </div>
  </div>
  {% endfor %}
</div>

<!-- Minimalist Bottom Control Bar -->
<div class="spotlight-bottom-bar">
  <!-- Right side (in RTL): Progress Line Indicators -->
