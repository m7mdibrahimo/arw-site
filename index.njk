/* ===== Spotlight Cinematic Hero (النمط السينمائي الفاخر للمواضيع المثبتة) ===== */
.spotlight-section {
  padding: 28px 20px 20px;
  position: relative;
  z-index: 5;
}
.spotlight-container {
  position: relative;
  border-radius: 24px;
  overflow: hidden;
  height: 420px;
  background: #0d131f;
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: 0 24px 60px -15px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.12);
  transition: border-color 0.4s ease, box-shadow 0.4s ease;
  cursor: grab;
  user-select: none;
  -webkit-user-select: none;
  touch-action: pan-y;
}
.spotlight-container.is-dragging {
  cursor: grabbing;
}
.spotlight-container * {
  -webkit-user-drag: none;
}
html.arw-dark .spotlight-container {
  border-color: rgba(255, 255, 255, 0.14);
  box-shadow: 0 26px 70px -15px rgba(0, 0, 0, 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.15);
}

.spotlight-ambient-glow {
  position: absolute;
  inset: -25px;
  border-radius: 36px;
  filter: blur(70px);
  opacity: 0.32;
  pointer-events: none;
  z-index: 0;
  transition: background 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}
html.arw-dark .spotlight-ambient-glow { opacity: 0.48; filter: blur(85px); }

.glow-wwe { background: radial-gradient(circle at 75% 50%, rgba(225, 45, 30, 0.85) 0%, transparent 65%); }
.glow-aew { background: radial-gradient(circle at 75% 50%, rgba(235, 195, 55, 0.85) 0%, transparent 65%); }
.glow-tna { background: radial-gradient(circle at 75% 50%, rgba(145, 95, 240, 0.85) 0%, transparent 65%); }
.glow-roh { background: radial-gradient(circle at 75% 50%, rgba(50, 110, 220, 0.85) 0%, transparent 65%); }
.glow-mma { background: radial-gradient(circle at 75% 50%, rgba(235, 125, 40, 0.85) 0%, transparent 65%); }
.glow-indie { background: radial-gradient(circle at 75% 50%, rgba(30, 160, 130, 0.85) 0%, transparent 65%); }

/* Slides Viewport */
.spotlight-viewport {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  z-index: 1;
}

.spotlight-slide {
  position: absolute;
  inset: 0;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.7s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0.7s ease;
  z-index: 1;
  display: flex;
  align-items: center;
}
.spotlight-slide.active {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  z-index: 2;
}

/* Full Clickable Area Link */
.spotlight-card-link {
  display: block;
  position: absolute;
  inset: 0;
  z-index: 5;
  cursor: pointer;
  pointer-events: auto;
}

/* Background Image positioned strictly to the LEFT */
.spotlight-bg-wrap {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 0;
  background: #0d131f;
}
.spotlight-bg-img {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 62%;
  height: 100%;
  object-fit: cover;
  object-position: center 25%;
  transform: scale(1);
  transition: transform 7s cubic-bezier(0.1, 0.9, 0.2, 1);
}
.spotlight-slide.active .spotlight-bg-img {
  transform: scale(1.045);
}

/* Floating Play Icon for Shows */
.spotlight-play-float {
  position: absolute;
  top: 50%;
  left: 26%;
  transform: translate(-50%, -50%) scale(0.95);
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: rgba(13, 19, 31, 0.65);
  border: 1.5px solid rgba(255, 255, 255, 0.35);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(12px);
  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4), 0 0 20px rgba(14, 149, 148, 0.3);
  z-index: 2;
  pointer-events: none;
  transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.spotlight-slide:hover .spotlight-play-float {
  transform: translate(-50%, -50%) scale(1.1);
  background: var(--teal);
  border-color: rgba(255, 255, 255, 0.8);
  box-shadow: 0 16px 40px rgba(14, 149, 148, 0.65);
}

/* Gradient Overlay: Seamlessly blends the right empty space into the image so it feels like one natural photo */
.spotlight-gradient-overlay {
  position: absolute;
  inset: 0;
  background: 
    linear-gradient(to left, 
      #0d131f 0%, 
      #0d131f 36%, 
      rgba(13, 19, 31, 0.88) 48%, 
      rgba(13, 19, 31, 0.45) 58%, 
      rgba(13, 19, 31, 0.08) 72%, 
      transparent 85%),
    linear-gradient(to top, 
      rgba(13, 19, 31, 0.88) 0%, 
      rgba(13, 19, 31, 0.2) 25%, 
      transparent 50%);
  pointer-events: none;
  z-index: 1;
}

/* Slide Content on the RIGHT (RTL) */
.spotlight-content {
  position: relative;
  z-index: 2;
  padding: 42px 52px 46px;
  max-width: 640px;
  text-align: right;
  pointer-events: none;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 20px;
}

/* Fluid Staggered Entrance Motion */
.spotlight-slide .spotlight-badges,
.spotlight-slide .spotlight-title-group,
.spotlight-slide .spotlight-actions {
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}
.spotlight-slide.active .spotlight-badges {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.1s;
}
.spotlight-slide.active .spotlight-title-group {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.18s;
}
.spotlight-slide.active .spotlight-actions {
  opacity: 1;
  transform: translateY(0);
  transition-delay: 0.26s;
}

/* Meta Badges */
.spotlight-badges {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0;
  flex-wrap: wrap;
}
.spotlight-pill {
  font-size: 12.5px;
  font-weight: 800;
  padding: 5px 14px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  letter-spacing: 0.2px;
}

.fed-pill-wwe { background: rgba(225, 45, 30, 0.22); color: #ff786b; border: 1px solid rgba(225, 45, 30, 0.45); }
.fed-pill-aew { background: rgba(235, 195, 55, 0.22); color: #fbbf24; border: 1px solid rgba(235, 195, 55, 0.45); }
.fed-pill-tna { background: rgba(145, 95, 240, 0.22); color: #c4b5fd; border: 1px solid rgba(145, 95, 240, 0.45); }
.fed-pill-roh { background: rgba(50, 110, 220, 0.22); color: #93c5fd; border: 1px solid rgba(50, 110, 220, 0.45); }
.fed-pill-mma { background: rgba(235, 125, 40, 0.22); color: #fdba74; border: 1px solid rgba(235, 125, 40, 0.45); }
.fed-pill-indie { background: rgba(30, 160, 130, 0.22); color: #5eead4; border: 1px solid rgba(30, 160, 130, 0.45); }

.type-pill {
  background: rgba(255, 255, 255, 0.1);
  color: #ffffff;
  border: 1px solid rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(6px);
}
.custom-badge {
  background: linear-gradient(135deg, rgba(245, 158, 11, 0.3), rgba(239, 68, 68, 0.3));
  color: #fef08a;
  border: 1px solid rgba(245, 158, 11, 0.55);
  font-weight: 900;
  box-shadow: 0 0 16px rgba(245, 158, 11, 0.2);
}

/* Headline & Secondary Title */
.spotlight-title-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.spotlight-title {
  margin: 0;
  font-family: 'Cairo', sans-serif;
  font-weight: 900;
  font-size: 30px;
  line-height: 1.38;
  letter-spacing: -0.4px;
}
.spotlight-title-text {
  color: #ffffff;
  text-shadow: 0 3px 16px rgba(0, 0, 0, 0.85);
  transition: color 0.25s ease;
}
.spotlight-slide:hover .spotlight-title-text {
  color: #38bdf8;
}
.spotlight-subtitle {
  font-family: 'Cairo', system-ui, -apple-system, sans-serif;
  font-size: 15.5px;
  font-weight: 700;
  color: #94a3b8;
  letter-spacing: 0.5px;
  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.85);
  display: block;
  width: 100%;
  text-align: right;
  direction: ltr;
  unicode-bidi: isolate;
}

/* Actions CTA Button */
.spotlight-actions {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 6px;
}
.spotlight-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, var(--teal), #0d9488);
  color: #ffffff !important;
  font-family: 'Cairo', sans-serif;
  font-weight: 800;
  font-size: 14.5px;
  padding: 11px 24px;
  border-radius: 12px;
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: 0 8px 24px rgba(14, 149, 148, 0.4);
  position: relative;
  overflow: hidden;
}
.spotlight-cta-btn::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.25), transparent);
  transform: skewX(-20deg);
  transition: 0.6s ease;
}
.spotlight-slide:hover .spotlight-cta-btn::after {
  left: 140%;
}
.spotlight-slide:hover .spotlight-cta-btn {
  background: linear-gradient(135deg, #0d9488, var(--teal));
  transform: translateY(-2px) scale(1.04);
  box-shadow: 0 12px 30px rgba(14, 149, 148, 0.55);
}
.spotlight-cta-btn svg {
  transition: transform 0.25s ease;
}
.spotlight-slide:hover .spotlight-cta-btn svg {
  transform: translateX(-4px);
}

/* Minimalist Bottom Progress Lines, Navigation & Counter */
.spotlight-bottom-bar {
  position: absolute;
  bottom: 18px;
  left: 26px;
  right: 26px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 10;
  pointer-events: none;
}
.spotlight-bars-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  pointer-events: auto;
}
.spotlight-bar-seg {
  width: 34px;
  height: 4px;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.2);
  cursor: pointer;
  position: relative;
  overflow: hidden;
  border: none;
  padding: 0;
  transition: width 0.35s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.25s ease;
}
.spotlight-bar-seg:hover {
  background: rgba(255, 255, 255, 0.45);
}
.spotlight-bar-seg.active {
  width: 56px;
  background: rgba(255, 255, 255, 0.25);
}
.spotlight-bar-fill {
  position: absolute;
  top: 0;
  right: 0;
  height: 100%;
  width: 0%;
  background: var(--teal);
  border-radius: 4px;
}
.spotlight-bar-seg.active .spotlight-bar-fill {
  background: linear-gradient(90deg, var(--teal), #38bdf8);
}

.spotlight-nav-group {
  display: flex;
  align-items: center;
  gap: 8px;
  pointer-events: auto;
}
.spotlight-nav-btn {
  width: 35px;
  height: 35px;
  border-radius: 10px;
  background: rgba(15, 20, 30, 0.7);
  border: 1px solid rgba(255, 255, 255, 0.16);
  color: #ffffff;
  backdrop-filter: blur(10px);
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.spotlight-nav-btn:hover {
  background: var(--teal);
  border-color: var(--teal);
  transform: scale(1.1);
  box-shadow: 0 0 16px rgba(14, 149, 148, 0.45);
}
.spotlight-nav-btn:active {
  transform: scale(0.92);
}

