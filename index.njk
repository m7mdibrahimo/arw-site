<script>
(function(){
var header = document.querySelector('header');
if(!header) return;
var lastY = window.scrollY;
var ticking = false;
function onScroll(){
var currentY = window.scrollY;
if(window.innerWidth <= 600){
if(currentY > lastY && currentY > 80){
header.classList.add('header-hidden');
} else if(currentY < lastY){
header.classList.remove('header-hidden');
}
} else {
header.classList.remove('header-hidden');
}
lastY = currentY;
ticking = false;
}
window.addEventListener('scroll', function(){
if(!ticking){
requestAnimationFrame(onScroll);
ticking = true;
}
}, {passive:true});
})();
</script>
<script>
(function(){
  const hero = document.getElementById('spotlightHero');
  if(!hero) return;
  const viewport = document.getElementById('spotlightViewport');
  const slides = Array.from(hero.querySelectorAll('.spotlight-slide'));
  const barSegs = Array.from(hero.querySelectorAll('.spotlight-bar-seg'));
  const glow = document.getElementById('spotlightAmbientGlow');
  const prevBtn = document.getElementById('spotlightPrevBtn');
  const nextBtn = document.getElementById('spotlightNextBtn');

  if(slides.length === 0) return;

  let currentIndex = 0;
  const total = slides.length;
  const DURATION = 6500;
  let startTime = Date.now();
  let animFrame = null;
  let isPaused = false;

  function updateSlide(idx) {
    currentIndex = (idx + total) % total;

    slides.forEach((s, i) => {
      s.classList.toggle('active', i === currentIndex);
    });

    barSegs.forEach((bar, i) => {
      const isActive = (i === currentIndex);
      bar.classList.toggle('active', isActive);
      const fill = bar.querySelector('.spotlight-bar-fill');
      if (fill) fill.style.width = '0%';
    });

    const fed = slides[currentIndex].getAttribute('data-fed') || 'wwe';
    if(glow) {
      glow.className = `spotlight-ambient-glow glow-${fed}`;
    }

    startTime = Date.now();
  }

  function startAutoplay() {
    cancelAnimationFrame(animFrame);
    startTime = Date.now();

    function tick() {
      if (!isPaused) {
        const elapsed = Date.now() - startTime;
        const pct = Math.min((elapsed / DURATION) * 100, 100);
        const activeBar = barSegs[currentIndex];
        if (activeBar) {
          const fill = activeBar.querySelector('.spotlight-bar-fill');
          if (fill) fill.style.width = `${pct}%`;
        }

        if (elapsed >= DURATION) {
          updateSlide(currentIndex + 1);
        }
      }
      animFrame = requestAnimationFrame(tick);
    }
    animFrame = requestAnimationFrame(tick);
  }

  barSegs.forEach((bar, idx) => {
    bar.addEventListener('click', (e) => {
      e.stopPropagation();
      updateSlide(idx);
    });
  });

  if (prevBtn) {
    prevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      e.preventDefault();
      updateSlide(currentIndex - 1);
    });
  }
  if (nextBtn) {
    nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      e.preventDefault();
      updateSlide(currentIndex + 1);
    });
  }

  hero.addEventListener('mouseenter', () => { isPaused = true; });
  hero.addEventListener('mouseleave', () => { isPaused = false; startTime = Date.now(); });

  // Mobile-aware Touch & Mouse Swipe Handling
  // Prevents opening links or blocking page scroll when scrolling down on phone
  let isPointerDown = false;
  let startX = 0;
  let startY = 0;
  let moveX = 0;
  let moveY = 0;
  let isHorizontalSwipe = false;
  let isVerticalScroll = false;
  let isClickBlocked = false;
  let pointerDownTime = 0;

  hero.addEventListener('dragstart', (e) => {
    e.preventDefault();
    return false;
  });

  hero.addEventListener('pointerdown', (e) => {
    if (e.button !== undefined && e.button !== 0) return;
    if (e.target.closest('#spotlightPrevBtn') || e.target.closest('#spotlightNextBtn') || e.target.closest('.spotlight-bar-seg')) return;

    isPointerDown = true;
    isHorizontalSwipe = false;
    isVerticalScroll = false;
    isClickBlocked = false;
    isPaused = true;
    startX = e.clientX;
    startY = e.clientY;
    moveX = 0;
    moveY = 0;
    pointerDownTime = Date.now();
  });

  hero.addEventListener('pointermove', (e) => {
    if (!isPointerDown) return;
    moveX = e.clientX - startX;
    moveY = e.clientY - startY;

    const absX = Math.abs(moveX);
    const absY = Math.abs(moveY);

    // If user has moved their finger/mouse vertically more than horizontally, they are SCROLLING the page!
    if (!isHorizontalSwipe && !isVerticalScroll) {
      if (absY > 7 && absY >= absX) {
        // Confirmed vertical page scroll: do NOT hijack pointer, block link click
        isVerticalScroll = true;
        isClickBlocked = true;
        hero.classList.remove('is-dragging');
        return;
      } else if (absX > 10 && absX > absY) {
        // Confirmed horizontal slider swipe: activate slider drag
        isHorizontalSwipe = true;
        isClickBlocked = true;
        hero.classList.add('is-dragging');
        try {
          if (!hero.hasPointerCapture(e.pointerId)) {
            hero.setPointerCapture(e.pointerId);
          }
        } catch (_) {}
      }
    }

    // If already detected as vertical scroll, block any accidental click
    if (isVerticalScroll || absY > 7) {
      isClickBlocked = true;
    }
  });

  function handlePointerUp(e) {
    if (!isPointerDown) return;
    isPointerDown = false;
    hero.classList.remove('is-dragging');
    isPaused = false;
    startTime = Date.now();

    const elapsed = Date.now() - pointerDownTime;
    const absX = Math.abs(moveX);
    const absY = Math.abs(moveY);

    try {
      if (e.pointerId !== undefined && hero.hasPointerCapture(e.pointerId)) {
        hero.releasePointerCapture(e.pointerId);
      }
    } catch (_) {}

    if (isHorizontalSwipe && absX > 25 && absX > absY) {
      // Intentional horizontal swipe -> change slide
      if (moveX > 0) {
        updateSlide(currentIndex - 1);
      } else {
        updateSlide(currentIndex + 1);
      }
    }

    // Keep click blocked briefly so native <a> click won't trigger if user was scrolling or swiping
    if (isClickBlocked || isVerticalScroll || isHorizontalSwipe || absX > 8 || absY > 8) {
      setTimeout(() => {
        isClickBlocked = false;
        isHorizontalSwipe = false;
        isVerticalScroll = false;
        moveX = 0;
        moveY = 0;
      }, 150);
    }
  }

  hero.addEventListener('pointerup', handlePointerUp);
  hero.addEventListener('pointercancel', handlePointerUp);

  // Strictly block link navigation if user was scrolling vertically or swiping horizontally
  hero.querySelectorAll('.spotlight-card-link, a').forEach(link => {
    link.addEventListener('click', (e) => {
      const absX = Math.abs(moveX);
      const absY = Math.abs(moveY);
      if (isClickBlocked || isVerticalScroll || isHorizontalSwipe || absX > 8 || absY > 8) {
        e.preventDefault();
        e.stopPropagation();
      }
    });
  });

  document.addEventListener('keydown', (e) => {
    if (document.activeElement && (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA')) return;
    if (e.key === 'ArrowRight') updateSlide(currentIndex - 1);
    if (e.key === 'ArrowLeft') updateSlide(currentIndex + 1);
  });

  updateSlide(0);
  startAutoplay();
})();
</script>
</body>
