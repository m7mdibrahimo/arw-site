.news-card:hover .news-body h3{ color:var(--coral); }
footer{ padding:40px 24px; text-align:center; color:var(--muted); font-size:13px; border-top:1px solid var(--line); }
  .footer-nav{ display:flex; justify-content:center; flex-wrap:wrap; gap:10px 18px; margin:18px 0 14px; font-weight:700; font-size:14.5px; }
  .footer-nav a{ color:var(--ink); text-decoration:none; transition:color 0.2s ease, transform 0.2s ease; }
