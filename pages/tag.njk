<div class="page-head">
  <h1>وسم: #{{ tagObj.name }}</h1>
  <p>عروض وأخبار وملخصات المصارعة المتعلقة بـ #{{ tagObj.name }} ({{ tagObj.count }} نتائج)</p>
</div>

<section class="content"><div class="wrap"><div class="grid-12" id="tagGrid">
{% for item in tagPage.items %}
  <a class="{% if item.kind == 'news' %}news-card{% else %}show-card{% endif %} reveal" href="{{ item.url | cleanUrl }}">
    {% if item.kind == 'news' %}
    <div class="news-thumb"><img class="thumb-img" src="{% optImg item.data.image, 'https://images.unsplash.com/photo-1563844528129-067e06a638e5?w=800&auto=format&fit=crop' %}" alt="{{ item.data.title }}" loading="lazy" width="450" height="160"></div>
    <div class="news-body">
      <span class="kind-badge kind-news">خبر</span>{% if item.data.federation %}<span class="cat cat-{{ item.data.federation | lower }}">{{ item.data.federation }}</span>{% endif %}
      <h3>{{ item.data.title }}</h3>
      <span class="date">{{ item.date | date("dd MMM") }}</span>
    </div>
    {% else %}
    <div class="show-thumb"><img class="thumb-img" src="{% optImg item.data.image, 'https://images.unsplash.com/photo-1563844528129-067e06a638e5?w=800&auto=format&fit=crop' %}" alt="{{ item.data.headline or item.data.title }}" loading="lazy" width="400" height="160"><div class="play-btn"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" style="margin-right:-2px;"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86a1 1 0 0 0-1.5.86z"/></svg></div></div>
    <div class="show-body">
      {% if item.kind == 'show' %}<span class="kind-badge kind-show">عرض</span>{% else %}<span class="kind-badge kind-recap">ملخص</span>{% endif %}{% if item.data.federation %}<span class="cat cat-{{ item.data.federation | lower }}">{{ item.data.federation }}</span>{% endif %}
      <h3>{{ item.data.headline or item.data.title }}</h3>
    </div>
    {% endif %}
  </a>
{% endfor %}
</div>

{% if tagPage.totalPages > 1 %}
<nav class="pagination-nav" aria-label="تصفح الصفحات">
  <div class="pagination-wrap">
    {% if tagPage.previousHref %}
      <a href="{{ tagPage.previousHref }}" class="page-link prev" aria-label="الصفحة السابقة">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        <span>السابق</span>
      </a>
    {% else %}
      <span class="page-link prev disabled" aria-disabled="true">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        <span>السابق</span>
      </span>
    {% endif %}

    <div class="page-numbers">
      {% for pItem in tagPage.paginationItems %}
        {% if pItem.isEllipsis %}
          <span class="page-ellipsis" aria-hidden="true">…</span>
        {% elseif pItem.isCurrent %}
          <span class="page-link active" aria-current="page">{{ pItem.pageNum }}</span>
        {% else %}
          <a href="{{ pItem.url }}" class="page-link">{{ pItem.pageNum }}</a>
        {% endif %}
      {% endfor %}
    </div>

    {% if tagPage.nextHref %}
      <a href="{{ tagPage.nextHref }}" class="page-link next" aria-label="الصفحة التالية">
        <span>التالي</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </a>
    {% else %}
      <span class="page-link next disabled" aria-disabled="true">
        <span>التالي</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
      </span>
    {% endif %}
  </div>
</nav>
{% endif %}

</div></section>

<footer>
  <div class="social-row">
    <a aria-label="فيسبوك" href="https://www.facebook.com/ArabWrestlingEG/" target="_blank"><svg fill="currentColor" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.17 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.77 8.44-4.94 8.44-9.94Z"/></svg></a>
    <a aria-label="إنستجرام" href="https://www.instagram.com/arabwrestling/" target="_blank"><svg fill="none" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><rect height="18" rx="5" stroke="currentColor" stroke-width="2" width="18" x="3" y="3"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" fill="currentColor" r="1.2"/></svg></a>
    <a aria-label="اكس" href="https://x.com/ArabWrestlingEG" target="_blank" rel="noopener"><svg fill="currentColor" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
    <a aria-label="تيليجرام" href="https://t.me/arab_wrestling" target="_blank" rel="noopener"><svg fill="currentColor" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><path d="M20.665 3.717l-17.73 6.837c-1.21.486-1.203 1.161-.222 1.462l4.552 1.42 10.532-6.645c.498-.303.953-.14.579.192l-8.533 7.701h-.002l-.002.001-.314 4.692c.46 0 .663-.211.921-.46l2.211-2.15 4.599 3.397c.848.467 1.457.227 1.668-.785l3.019-14.228c.309-1.239-.473-1.8-1.282-1.434z"/></svg></a>
  </div>
  © 2026 عرب راسلنج — موقع عربي مستقل غير تابع لأي اتحاد رسمي.
</footer>

<script>
  (function(){
    var saved = null;
    try{ saved = localStorage.getItem('arw-theme'); }catch(e){}
    if(saved !== 'dark' && saved !== 'light'){
      try{
        var m = document.cookie.match(/(?:^|; )arw-theme=([^;]*)/);
        if(m) saved = decodeURIComponent(m[1]);
      }catch(e){}
    }
    if(saved === 'dark'){ document.documentElement.classList.add('arw-dark'); }
  })();
  document.getElementById('arwThemeToggle').addEventListener('click', function(){
    var isDark = document.documentElement.classList.toggle('arw-dark');
    var val = isDark ? 'dark' : 'light';
    try{ localStorage.setItem('arw-theme', val); }catch(e){}
    document.cookie = 'arw-theme=' + val + ';path=/;max-age=31536000';
  });
</script>
<script>
  if('IntersectionObserver' in window){
    const io = new IntersectionObserver((entries)=>{
      entries.forEach(e=>{
        if(e.isIntersecting){ e.target.classList.remove('reveal-hidden'); e.target.classList.add('is-visible'); }
        else { e.target.classList.remove('is-visible'); e.target.classList.add('reveal-hidden'); }
      });
    }, { threshold:.12 });
    document.querySelectorAll('.reveal').forEach(el=>{
      el.classList.add('reveal-hidden');
      io.observe(el);
    });
  }
</script>
<script src="/assets/notif.js" defer></script>
<script>
(function(){
  var header = document.querySelector('header');
  if(!header) return;
  var lastY = window.scrollY;
  var ticking = false;
  function onScroll(){
    var currentY = window.scrollY;
    if(window.innerWidth <= 600){
      if(currentY > lastY && currentY > 80){
        header.classList.add('header-hidden');
      } else if(currentY < lastY){
        header.classList.remove('header-hidden');
      }
    } else {
      header.classList.remove('header-hidden');
    }
    lastY = currentY;
    ticking = false;
  }
  window.addEventListener('scroll', function(){
    if(!ticking){
      requestAnimationFrame(onScroll);
      ticking = true;
    }
  }, {passive:true});
})();
</script>
</body>
</html>
