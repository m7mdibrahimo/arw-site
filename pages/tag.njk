---
pagination:
  data: collections.tagList
  size: 1
  alias: tagObj
permalink: /tag/{{ tagObj.slug }}/
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<script>if(window.location.hostname.includes('pages.dev')){window.location.replace('https://arab-wrestling.com'+window.location.pathname+window.location.search+window.location.hash);}</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>مواضيع الوسم #{{ tagObj.name }} | عرب راسلنج</title>
<meta name="description" content="جميع العروض والأخبار والملخصات المتعلقة بالوسم #{{ tagObj.name }} على موقع عرب راسلنج.">
<link rel="canonical" href="https://arab-wrestling.com/tag/{{ tagObj.slug }}/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800;900&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/notif.css">
<style>
  :root{
    --bg: #faf7f0; --card: #ffffff; --ink: #1e2530; --muted: #6c7383; --line: #ece6d8;
    --teal: #0e9594; --teal-soft: #e3f5f3; --coral: #ff6f59; --coral-soft: #ffece8;
    --gold: #f2a53c; --gold-soft: #fdf1de; --violet: #7c6ee8;
  }
  html.arw-dark{
    --bg:#0d0f13; --card:#171a20; --ink:#eef1f6; --muted:#9aa2b0; --line:rgba(255,255,255,.1);
    --teal:#1cb5b3; --teal-soft:rgba(28,181,179,.15); --coral:#ff8570; --coral-soft:rgba(255,133,112,.15);
    --gold:#f4b352; --gold-soft:rgba(244,179,82,.15); --violet:#9a8ff0;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{ scroll-behavior:smooth; }
  body{ background:var(--bg); color:var(--ink); font-family:'Tajawal',sans-serif; line-height:1.75; transition:background-color .3s ease, color .3s ease; }
  h1,h2,h3,.brand{ font-family:'Cairo',sans-serif; font-weight:900; }
  header{ position:sticky; top:0; z-index:50; background:var(--bg); backdrop-filter:blur(8px); border-bottom:1px solid var(--line); }
  .nav{ max-width:1180px; margin:0 auto; padding:16px 24px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px;}
  .brand{ font-weight:900; font-size:21px; text-decoration:none; color:var(--ink); white-space:nowrap; display:inline-flex; align-items:center; gap:10px; }
  .brand img.brand-logo{ width:36px; height:36px; object-fit:contain; border-radius:8px; filter:drop-shadow(0 2px 6px rgba(0,0,0,0.25)); transition:transform 0.3s ease; }
  .brand:hover img.brand-logo{ transform:rotate(6deg) scale(1.08); }
  .brand span{ color:var(--teal); }
  .nav ul{ list-style:none; display:flex; align-items:center; gap:6px; flex-wrap:wrap; white-space:nowrap; }
  .nav ul li{ display:inline-flex; align-items:center; }
  .nav a.navlink{ color:var(--ink); text-decoration:none; font-weight:700; font-size:14px; padding:9px 16px; border-radius:999px; transition:.2s; }
  .nav a.navlink:hover{ background:var(--teal-soft); color:var(--teal); }
  .nav a.navlink.active{ background:#1e2530; color:#fff; }
  html.arw-dark .nav a.navlink.active{ background:#fff; color:#1e2530; }
  .nav-dropdown{ position:relative; }
  .dropdown-menu{ display:flex !important; flex-direction:column; gap:2px !important; position:absolute; top:calc(100% + 10px); right:0; min-width:160px; background:var(--card); border:1px solid var(--line); border-radius:14px; padding:8px; box-shadow:0 16px 32px -16px rgba(0,0,0,.25); list-style:none; opacity:0; visibility:hidden; transform:translateY(-8px); transition:opacity .22s ease, transform .22s ease, visibility .22s; z-index:60; }
  .nav-dropdown:hover .dropdown-menu, .nav-dropdown:focus-within .dropdown-menu{ opacity:1; visibility:visible; transform:translateY(0); }
  .dropdown-menu li{ list-style:none; width:100%; }
  .dropdown-menu a{ display:block; padding:9px 12px; border-radius:999px; color:var(--ink); text-decoration:none; font-weight:700; font-size:13.5px; }
  .dropdown-menu a:hover{ background:var(--line); }
  .site-search{ flex:1; min-width:140px; max-width:420px; display:flex; align-items:center; background:var(--card); border:1px solid var(--line); border-radius:999px; padding:6px 8px 6px 16px; }
  .site-search input{ flex:1; border:none; outline:none; background:transparent; font-family:'Tajawal',sans-serif; font-size:14px; color:var(--ink); padding:6px 4px; }
  .site-search input::placeholder{ color:var(--muted); }
  .site-search button{ border:none; background:var(--teal); color:#fff; width:34px; height:34px; border-radius:50%; cursor:pointer; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .theme-toggle{ width:40px; height:40px; border-radius:50%; border:1px solid var(--line); background:var(--card); color:var(--ink); display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0; }
  .theme-toggle svg{ display:block; }
  .theme-toggle .icon-sun{ display:none; }
  html.arw-dark .theme-toggle .icon-moon{ display:none; }
  html.arw-dark .theme-toggle .icon-sun{ display:block; }
  .telegram-btn{ width:40px; height:40px; border-radius:50%; border:1px solid var(--line); background:var(--card); color:var(--ink); display:flex; align-items:center; justify-content:center; text-decoration:none; flex-shrink:0; transition:all 0.35s cubic-bezier(0.34,1.56,0.64,1); }
  .telegram-btn:hover{ transform:scale(1.1); border-color:var(--teal); color:var(--teal); }
  .telegram-btn:active{ transform:scale(0.92); }
  .page-head{ padding:56px 24px 36px; text-align:center; border-bottom:1px solid var(--line); }
  .page-head h1{ font-size:clamp(26px,4vw,36px); margin-bottom:8px; }
  .page-head p{ color:var(--muted); font-size:14.5px; }
  section.content{ padding:40px 24px 70px; }
  .wrap{ max-width:1180px; margin:0 auto; }
  .grid-12{ display:grid; grid-template-columns:repeat(12,1fr); gap:20px; }
  .grid-12 > *{ grid-column:span 3; }
  @media (max-width:900px){ .grid-12 > *{ grid-column:span 6; } }
  @media (max-width:560px){ .grid-12 > *{ grid-column:span 12; } }
  .show-card{ background:var(--card); border:1px solid var(--line); border-radius:16px; overflow:hidden; transition:.25s; display:block; text-decoration:none; color:var(--ink); }
  .show-card:hover{ transform:translateY(-4px); box-shadow:0 16px 26px -16px rgba(30,37,48,.22); }
  .show-thumb{ height:160px; background-size:cover; background-position:center; display:flex; align-items:center; justify-content:center; position:relative; }
  .show-thumb::before{ content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(0,0,0,.05), rgba(0,0,0,.35)); }
  .play-btn{ z-index:1; width:48px; height:48px; border-radius:50%; background:rgba(30,37,48,0.85); color:#fff; display:flex; align-items:center; justify-content:center; backdrop-filter:blur(4px); box-shadow:0 4px 14px rgba(0,0,0,0.3); transition:transform .2s ease, background-color .2s ease; }
  .show-card:hover .play-btn{ transform:scale(1.1); background:var(--teal); }
  .show-body{ padding:18px 20px; }
  .show-body .ep{ font-size:11.5px; color:var(--gold); font-weight:800; letter-spacing:.5px; }
  .show-body h3{ font-size:16.5px; font-weight:700; margin:8px 0 8px; }
  .news-thumb{ height:160px; background-size:cover; background-position:center; position:relative; }
  .news-thumb::before{ content:""; position:absolute; inset:0; background:linear-gradient(180deg, rgba(0,0,0,.05), rgba(0,0,0,.3)); }
  .news-body{ padding:18px 20px; }
  .news-body .date{ display:block; color:var(--muted); font-size:12px; border-top:1px solid var(--line); padding-top:10px; margin-top:10px; }
  .kind-badge{ display:inline-flex; align-items:center; font-size:10.5px; font-weight:800; padding:3px 10px; border-radius:999px; margin-inline-end:6px; margin-bottom:8px; vertical-align:middle; transition:transform 0.2s ease; }
  .cat, .fed-badge{ display:inline-flex; align-items:center; font-size:10.5px; font-weight:800; padding:3px 10px; border-radius:999px; background:var(--teal-soft); color:var(--teal); margin-bottom:8px; vertical-align:middle; transition:transform 0.2s ease, background-color 0.2s ease, color 0.2s ease; }
  
  .cat-wwe { background: rgba(199, 59, 44, 0.12) !important; color: #c73b2c !important; }
  .cat-aew { background: rgba(212, 160, 23, 0.14) !important; color: #9e7506 !important; }
  .cat-tna { background: rgba(138, 95, 224, 0.14) !important; color: #7c42d6 !important; }
  .cat-roh { background: rgba(44, 102, 199, 0.14) !important; color: #2358b5 !important; }
  .cat-mma { background: rgba(224, 122, 44, 0.14) !important; color: #c45b10 !important; }
  .cat-indie { background: rgba(31, 138, 114, 0.14) !important; color: #0f705b !important; }

  html.arw-dark .cat-wwe { background: rgba(225, 75, 60, 0.2) !important; color: #ff6b5b !important; }
  html.arw-dark .cat-aew { background: rgba(240, 195, 60, 0.2) !important; color: #f4b352 !important; }
  html.arw-dark .cat-tna { background: rgba(155, 109, 240, 0.2) !important; color: #b18cff !important; }
  html.arw-dark .cat-roh { background: rgba(70, 130, 240, 0.2) !important; color: #60a5fa !important; }
  html.arw-dark .cat-mma { background: rgba(240, 140, 60, 0.2) !important; color: #ff9d5c !important; }
  html.arw-dark .cat-indie { background: rgba(40, 180, 150, 0.2) !important; color: #34d399 !important; }

  .show-card:hover .kind-badge, .news-card:hover .kind-badge, .show-card:hover .cat, .news-card:hover .cat, .show-card:hover .fed-badge, .news-card:hover .fed-badge{ transform:scale(1.06); }
  .kind-show{ background:var(--gold-soft); color:var(--gold); }
  .kind-recap{ background:rgba(124,110,232,.15); color:var(--violet); }
  .kind-news{ background:var(--coral-soft); color:var(--coral); }
  .news-body h3, .show-body h3{ font-size:17px; font-weight:700; margin:4px 0 8px; }
  footer{ padding:40px 24px; text-align:center; color:var(--muted); font-size:13px; border-top:1px solid var(--line); }

  .pagination-nav { margin-top: 48px; display: flex; justify-content: center; align-items: center; width: 100%; }
  .pagination-wrap { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: center; }
  .page-numbers { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .page-link { display: inline-flex; align-items: center; justify-content: center; min-width: 42px; height: 42px; padding: 0 16px; border-radius: 12px; background: var(--card); border: 1px solid var(--line); color: var(--ink); font-weight: 700; font-size: 14.5px; text-decoration: none; transition: all 0.2s ease; cursor: pointer; }
  .page-link:hover:not(.disabled):not(.active) { border-color: var(--teal); color: var(--teal); background: var(--teal-soft); transform: translateY(-2px); }
  .page-link.active { background: var(--teal); border-color: var(--teal); color: #ffffff; cursor: default; }
  .page-link.disabled { opacity: 0.35; cursor: not-allowed; pointer-events: none; }
  .social-row{ display:flex; justify-content:center; gap:12px; margin-bottom:16px; }
  .social-row a{ width:38px; height:38px; border-radius:50%; background:var(--card); border:1px solid var(--line); display:flex; align-items:center; justify-content:center; color:var(--ink); transition:.2s; }
  .social-row a:hover{ background:var(--teal); color:#fff; border-color:var(--teal); }
</style>
</head>
<body>
<header>
  <div class="nav">
    <a class="brand" href="/">عرب <span>راسلنج</span></a>
    <form class="site-search" action="/search/" method="get">
      <input type="text" name="q" placeholder="اكتب ما تريد البحث عنه...">
      <button aria-label="بحث" type="submit"><svg fill="none" height="16" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21L16.65 16.65" stroke="currentColor" stroke-linecap="round" stroke-width="2"/></svg></button>
    </form>
    <ul>
      <li><a class="navlink" href="/">الرئيسية</a></li>
      <li class="nav-dropdown">
        <a class="navlink" href="/federations/">الاتحادات</a>
        <ul class="dropdown-menu">
          <li><a href="/federation/wwe/">WWE</a></li>
          <li><a href="/federation/aew/">AEW</a></li>
          <li><a href="/federation/tna/">TNA</a></li>
          <li><a href="/federation/roh/">ROH</a></li>
          <li><a href="/federation/mma/">MMA</a></li>
          <li><a href="/federation/indie/">INDIE</a></li>
        </ul>
      </li>
      <li><a class="navlink" href="/shows/">عروض المصارعة</a></li>
      <li><a class="navlink" href="/recaps/">ملخصات العروض</a></li>
      <li><a class="navlink" href="/news/">الأخبار</a></li>
      <li>
        <button aria-label="تفعيل إشعارات العروض والملخصات" class="notif-toggle" id="arwNotifToggle" type="button" title="إشعارات العروض والملخصات الجديدة">
          <svg class="icon-bell" width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 22C13.1 22 14 21.1 14 20H10C10 21.1 10.9 22 12 22ZM18 16V11C18 7.93 16.36 5.36 13.5 4.68V4C13.5 3.17 12.83 2.5 12 2.5C11.17 2.5 10.5 3.17 10.5 4V4.68C7.63 5.36 6 7.92 6 11V16L4 18V19H20V18L18 16Z" fill="currentColor"/></svg>
          <span class="notif-badge" id="arwNotifBadge"></span>
        </button>
      </li>
      <li>
        <button aria-label="تبديل الوضع الليلي" class="theme-toggle" id="arwThemeToggle" type="button">
          <svg class="icon-moon" fill="none" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79Z" fill="currentColor"/></svg>
          <svg class="icon-sun" fill="none" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" fill="currentColor" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke="currentColor" stroke-linecap="round" stroke-width="2"/></svg>
        </button>
      </li>
      <li>
        <a aria-label="قناة التليجرام" class="telegram-btn" href="https://t.me/arab_wrestling" target="_blank" rel="noopener" title="قناة التليجرام الرسمية">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M20.665 3.717l-17.73 6.837c-1.21.486-1.203 1.161-.222 1.462l4.552 1.42 10.532-6.645c.498-.303.953-.14.579.192l-8.533 7.701h-.002l-.002.001-.314 4.692c.46 0 .663-.211.921-.46l2.211-2.15 4.599 3.397c.848.467 1.457.227 1.668-.785l3.019-14.228c.309-1.239-.473-1.8-1.282-1.434z"/></svg>
        </a>
      </li>
    </ul>
  </div>
</header>

<div class="page-head">
  <h1>وسم: #{{ tagObj.name }}</h1>
  <p>عروض وأخبار وملخصات المصارعة المتعلقة بـ #{{ tagObj.name }} ({{ tagObj.count }} نتائج)</p>
</div>

<section class="content"><div class="wrap"><div class="grid-12" id="tagGrid">
{% for item in collections.allContent %}
  {% set hasTag = false %}
  {% if item.data.tags %}
    {% if tagObj.name in item.data.tags %}
      {% set hasTag = true %}
    {% endif %}
  {% endif %}

  {% if hasTag %}
  <a class="show-card" href="{{ item.url }}">
    {% if item.kind == 'news' %}
    <div class="news-thumb" style="background-image:url('{% optImg item.data.image, 'https://images.unsplash.com/photo-1563844528129-067e06a638e5?w=800&auto=format&fit=crop' %}')"></div>
    <div class="news-body">
      <span class="kind-badge kind-news">خبر</span>{% if item.data.federation %}<span class="cat cat-{{ item.data.federation | lower }}">{{ item.data.federation }}</span>{% endif %}
      <h3>{{ item.data.title }}</h3>
      <span class="date">{{ item.date | date("dd MMM") }}</span>
    </div>
    {% else %}
    <div class="show-thumb" style="background-image:url('{% optImg item.data.image, 'https://images.unsplash.com/photo-1563844528129-067e06a638e5?w=800&auto=format&fit=crop' %}')"><div class="play-btn"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" style="margin-right:-2px;"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86a1 1 0 0 0-1.5.86z"/></svg></div></div>
    <div class="show-body">
      {% if item.kind == 'show' %}<span class="kind-badge kind-show">عرض</span>{% else %}<span class="kind-badge kind-recap">ملخص</span>{% endif %}{% if item.data.federation %}<span class="cat cat-{{ item.data.federation | lower }}">{{ item.data.federation }}</span>{% endif %}
      <h3>{{ item.data.headline or item.data.title }}</h3>
    </div>
    {% endif %}
  </a>
  {% endif %}
{% endfor %}
</div>
<div id="tagPagination"></div>
</div></section>

<script>
  (function(){
    var grid = document.getElementById('tagGrid');
    if(!grid) return;
    var items = Array.from(grid.children);
    var pageSize = 20;
    if(items.length <= pageSize) return;

    var totalPages = Math.ceil(items.length / pageSize);
    var currentPage = 1;

    function renderPage(page){
      currentPage = page;
      var start = (page - 1) * pageSize;
      var end = start + pageSize;
      items.forEach(function(item, idx){
        item.style.display = (idx >= start && idx < end) ? '' : 'none';
      });

      var container = document.getElementById('tagPagination');
      if(!container) return;

      var navHtml = '<nav class="pagination-nav"><div class="pagination-wrap">';
      navHtml += currentPage > 1 ? '<button class="page-link prev" data-page="' + (currentPage - 1) + '">السابق</button>' : '<span class="page-link prev disabled">السابق</span>';
      navHtml += '<div class="page-numbers">';
      for(var i = 1; i <= totalPages; i++){
        if(i === currentPage){
          navHtml += '<span class="page-link active">' + i + '</span>';
        } else {
          navHtml += '<button class="page-link" data-page="' + i + '">' + i + '</button>';
        }
      }
      navHtml += '</div>';
      navHtml += currentPage < totalPages ? '<button class="page-link next" data-page="' + (currentPage + 1) + '">التالي</button>' : '<span class="page-link next disabled">التالي</span>';
      navHtml += '</div></nav>';
      container.innerHTML = navHtml;

      container.querySelectorAll('button[data-page]').forEach(function(btn){
        btn.addEventListener('click', function(){
          renderPage(parseInt(this.getAttribute('data-page'), 10));
          window.scrollTo({ top: grid.offsetTop - 100, behavior: 'smooth' });
        });
      });
    }

    renderPage(1);
  })();
</script>

<footer>
  <div class="social-row">
    <a aria-label="فيسبوك" href="#" target="_blank"><svg fill="currentColor" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.17 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.77 8.44-4.94 8.44-9.94Z"/></svg></a>
    <a aria-label="إنستجرام" href="#" target="_blank"><svg fill="none" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><rect height="18" rx="5" stroke="currentColor" stroke-width="2" width="18" x="3" y="3"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" fill="currentColor" r="1.2"/></svg></a>
    <a aria-label="تيليجرام" href="https://t.me/arab_wrestling" target="_blank" rel="noopener"><svg fill="currentColor" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><path d="M20.665 3.717l-17.73 6.837c-1.21.486-1.203 1.161-.222 1.462l4.552 1.42 10.532-6.645c.498-.303.953-.14.579.192l-8.533 7.701h-.002l-.002.001-.314 4.692c.46 0 .663-.211.921-.46l2.211-2.15 4.599 3.397c.848.467 1.457.227 1.668-.785l3.019-14.228c.309-1.239-.473-1.8-1.282-1.434z"/></svg></a>
  </div>
  © 2026 عرب راسلنج — موقع عربي مستقل غير تابع لأي اتحاد رسمي.
</footer>

<script>
  (function(){
    var saved = null;
    try{ saved = localStorage.getItem('arw-theme'); }catch(e){}
    if(saved !== 'dark' && saved !== 'light'){
      try{
        var m = document.cookie.match(/(?:^|; )arw-theme=([^;]*)/);
        if(m) saved = decodeURIComponent(m[1]);
      }catch(e){}
    }
    if(saved === 'dark'){ document.documentElement.classList.add('arw-dark'); }
  })();
  document.getElementById('arwThemeToggle').addEventListener('click', function(){
    var isDark = document.documentElement.classList.toggle('arw-dark');
    var val = isDark ? 'dark' : 'light';
    try{ localStorage.setItem('arw-theme', val); }catch(e){}
    document.cookie = 'arw-theme=' + val + ';path=/;max-age=31536000';
  });
</script>
<script src="/assets/notif.js" defer></script>
