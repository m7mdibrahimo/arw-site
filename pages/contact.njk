<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<script>if(window.location.hostname.includes("pages.dev")){window.location.replace("https://arab-wrestling.com"+window.location.pathname+window.location.search+window.location.hash);}</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">
<link rel="icon" type="image/png" href="/favicon.png?v=2">
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
<title>اتصل بنا | عرب راسلنج</title>
<meta name="description" content="تواصل مع إدارة وهيئة تحرير موقع عرب راسلنج، أرسل استفسارك أو اقتراحك أو إشعارات حقوق الملكية الفكرية مباشرة.">
<link rel="canonical" href="https://arab-wrestling.com/contact/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800;900&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #faf7f0; --card: #ffffff; --ink: #1e2530; --muted: #6c7383; --line: #ece6d8;
    --teal: #0e9594; --teal-dark: #0a6c6b; --accent: #d90429;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{ font-family:"Tajawal",sans-serif; background:var(--bg); color:var(--ink); line-height:1.8; }
  header{ background:var(--card); border-bottom:1px solid var(--line); padding:20px 24px; display:flex; justify-content:space-between; align-items:center; }
  header a{ color:var(--teal); text-decoration:none; font-family:"Cairo",sans-serif; font-weight:900; font-size:20px; }
  header nav a{ margin-inline-start:16px; font-size:14px; color:var(--muted); font-weight:600; text-decoration:none; }
  header nav a:hover{ color:var(--teal); }
  main{ max-width:680px; margin:0 auto; padding:40px 20px 80px; }
  .contact-header{ text-align:center; margin-bottom:36px; }
  .contact-header h1{ font-family:"Cairo",sans-serif; font-weight:900; font-size:30px; margin-bottom:10px; color:var(--ink); }
  .contact-header p{ color:var(--muted); font-size:16px; max-width:540px; margin:0 auto; }
  
  .form-card{ background:var(--card); border:1px solid var(--line); border-radius:14px; padding:32px; box-shadow:0 6px 20px rgba(0,0,0,0.03); }
  .form-group{ margin-bottom:20px; }
  .form-group label{ display:block; font-family:"Cairo",sans-serif; font-weight:700; font-size:14px; margin-bottom:8px; color:var(--ink); }
  .form-group label span{ color:var(--accent); }
  .form-control{ width:100%; padding:13px 16px; border:1px solid var(--line); border-radius:10px; font-family:"Tajawal",sans-serif; font-size:15px; background:#fdfdfd; color:var(--ink); transition:all .2s; outline:none; }
  .form-control:focus{ border-color:var(--teal); background:#fff; box-shadow:0 0 0 3px rgba(14,149,148,0.15); }
  textarea.form-control{ min-height:140px; resize:vertical; }
  
  .submit-btn{ width:100%; padding:14px; background:var(--teal); color:#fff; border:none; border-radius:10px; font-family:"Cairo",sans-serif; font-weight:800; font-size:16px; cursor:pointer; transition:all .2s; display:flex; justify-content:center; align-items:center; gap:8px; }
  .submit-btn:hover{ background:var(--teal-dark); transform:translateY(-1px); box-shadow:0 4px 14px rgba(14,149,148,0.3); }
  .submit-btn:disabled{ opacity:0.6; cursor:not-allowed; transform:none; }
  
  .honeypot{ display:none !important; }
  
  .alert-box{ display:none; padding:18px 20px; border-radius:10px; margin-top:20px; font-size:15px; line-height:1.7; text-align:center; }
  .alert-success{ background:#e6f7f0; border:1px solid #a3e6cb; color:#0d6832; }
  .alert-error{ background:#fde8e8; border:1px solid #f8b4b4; color:#9b1c1c; }
  
  .social-channels{ margin-top:36px; text-align:center; padding:24px; background:var(--card); border:1px solid var(--line); border-radius:14px; }
  .social-channels h3{ font-family:"Cairo",sans-serif; font-size:16px; margin-bottom:12px; color:var(--ink); }
  .social-icons{ display:flex; justify-content:center; gap:16px; }
  .social-icons a{ display:inline-flex; align-items:center; gap:6px; color:var(--teal); text-decoration:none; font-weight:600; font-size:14px; padding:8px 14px; background:rgba(14,149,148,0.08); border-radius:8px; transition:background .2s; }
  .social-icons a:hover{ background:rgba(14,149,148,0.16); }

  footer{ padding:40px 24px; text-align:center; color:var(--muted); font-size:13px; border-top:1px solid var(--line); background:var(--card); margin-top:40px; }
  .footer-links{ margin-bottom:12px; }
  .footer-links a{ color:var(--muted); margin:0 8px; font-size:13px; text-decoration:none; }
  .footer-links a:hover{ color:var(--teal); }
</style>
</head>
<body>
<header>
  <a href="/">عرب راسلنج</a>
  <nav>
    <a href="/">الرئيسية</a>
    <a href="/news/">الأخبار</a>
    <a href="/dmca/">حقوق النشر (DMCA)</a>
    <a href="/support/">ادعم الموقع</a>
  </nav>
</header>
<main>
  <div class="contact-header">
    <h1>تواصل معنا</h1>
    <p>يسعدنا دائماً استقبال رسائلكم واستفساراتكم، وملاحظاتكم، واقتراحاتكم لتطوير الموقع.</p>
  </div>

  <div class="form-card">
    <form id="contactForm">
      <input type="text" name="_honey" class="honeypot" tabindex="-1" autocomplete="off">
      
      <div class="form-group">
        <label for="name">الاسم بالكامل <span>*</span></label>
        <input type="text" id="name" name="name" class="form-control" placeholder="اكتب اسمك هنا" required>
      </div>

      <div class="form-group">
        <label for="email">بريدك الإلكتروني <span>*</span></label>
        <input type="email" id="email" name="email" class="form-control" placeholder="example@email.com" required dir="ltr" style="text-align:right;">
      </div>

      <div class="form-group">
        <label for="subject">نوع الرسالة / الموضوع <span>*</span></label>
        <select id="subject" name="subject" class="form-control" required>
          <option value="استفسار عام">استفسار عام</option>
          <option value="اقتراح لمحتوى أو تغطية خاصة">اقتراح لمحتوى أو تغطية خاصة</option>
          <option value="إشعار حقوق ملكية فكرية (DMCA)">إشعار حقوق ملكية فكرية (DMCA)</option>
          <option value="إبلاغ عن مشكلة فنية بالموقع">إبلاغ عن مشكلة فنية بالموقع</option>
          <option value="أخرى">أخرى</option>
        </select>
      </div>

      <div class="form-group">
        <label for="message">نص الرسالة <span>*</span></label>
        <textarea id="message" name="message" class="form-control" placeholder="اكتب تفاصيل رسالتك أو استفسارك هنا..." required></textarea>
      </div>

      <button type="submit" id="submitBtn" class="submit-btn">
        <span>إرسال الرسالة</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
      </button>

      <div id="successAlert" class="alert-box alert-success">
        <strong>تم إرسال رسالتك بنجاح! ✅</strong><br>
        شكراً لتواصلك معنا، تم استلام رسالتك بأمان وسنقوم بمراجعتها والرد عليك عبر بريدك الإلكتروني في أقرب وقت.
      </div>

      <div id="errorAlert" class="alert-box alert-error">
        <strong>حدث خطأ أثناء الإرسال! ❌</strong><br>
        يرجى التأكد من ملء الحقول والمحاولة مرة أخرى أو التواصل معنا عبر صفحاتنا الرسمية.
      </div>
    </form>
  </div>

  <div class="social-channels">
    <h3>أو يمكنك مراسلتنا مباشرة عبر منصاتنا الرسمية:</h3>
    <div class="social-icons">
      <a href="https://www.facebook.com/ArabWrestlingEG/" target="_blank" rel="noopener">
        <span>فيسبوك Facebook</span>
      </a>
      <a href="https://www.instagram.com/arabwrestling/" target="_blank" rel="noopener">
        <span>إنستجرام Instagram</span>
      </a>
      <a href="https://t.me/arab_wrestling" target="_blank" rel="noopener">
        <span>تيليجرام Telegram</span>
      </a>
    </div>
  </div>
</main>

<footer>
  <div class="footer-links">
    <a href="/">الرئيسية</a> |
    <a href="/news/">الأخبار</a> |
    <a href="/about/">من نحن</a> |
    <a href="/privacy/">سياسة الخصوصية</a> |
    <a href="/dmca/">حقوق الملكية والنشر (DMCA)</a> |
    <a href="/terms/">شروط الاستخدام</a> |
    <a href="/contact/">تواصل معنا</a>
  </div>
  <div>© 2026 عرب راسلنج — موقع عربي إخباري مستقل غير تابع لأي اتحاد رسمي.</div>
</footer>

<script>
document.getElementById("contactForm").addEventListener("submit", async function(e) {
  e.preventDefault();
  
  var form = e.target;
  var honey = form._honey ? form._honey.value : "";
  if (honey) return; // Silent drop for bots
  
  var submitBtn = document.getElementById("submitBtn");
  var successAlert = document.getElementById("successAlert");
  var errorAlert = document.getElementById("errorAlert");
  
  successAlert.style.display = "none";
  errorAlert.style.display = "none";
  submitBtn.disabled = true;
  submitBtn.innerHTML = "<span>جاري الإرسال بأمان...</span>";
  
  var data = {
    name: form.name.value.trim(),
    email: form.email.value.trim(),
    subject: form.subject.value,
    message: form.message.value.trim(),
    _subject: "رسالة جديدة من موقع عرب راسلنج: " + form.subject.value,
    _template: "table",
    _captcha: "false"
  };
  
  // Obfuscated destination to shield against scrapers
  var target = atob("bTdtZGlicmFoaW1wY0BnbWFpbC5jb20=");
  
  try {
    var response = await fetch("https://formsubmit.co/ajax/" + target, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      body: JSON.stringify(data)
    });
    
    if (response.ok) {
      form.reset();
      submitBtn.style.display = "none";
      successAlert.style.display = "block";
    } else {
      throw new Error("HTTP error " + response.status);
    }
  } catch (err) {
    console.error(err);
    submitBtn.disabled = false;
    submitBtn.innerHTML = "<span>إعادة المحاولة</span>";
    errorAlert.style.display = "block";
  }
});
</script>
</body>
</html>
