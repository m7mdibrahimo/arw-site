    {% endif %}

    <div class="page-numbers">
      {% for pageHref in pagination.hrefs %}
        {% set pageNum = loop.index %}
        {% if pageHref == page.url %}
          <span class="page-link active">{{ pageNum }}</span>
        {% else %}
          <a href="{{ pageHref }}" class="page-link">{{ pageNum }}</a>
        {% endif %}
      {% endfor %}
    </div>

    {% if pagination.href.next %}
      <a href="{{ pagination.href.next }}" class="page-link next">التالي</a>
    {% else %}
      <span class="page-link next disabled">التالي</span>
    {% endif %}
