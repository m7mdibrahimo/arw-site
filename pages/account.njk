<main class="acct-page" id="acct" data-api="https://arw-site-bot.m7mdibrahimpc.workers.dev/members" data-avatars="{{ asset('/assets/avatars/credits.json').split('?v=')[1] }}">
  <div class="acct-shell">
    <section class="acct-card" aria-live="polite">
      <div class="acct-view" data-view="loading"><div class="acct-spin" aria-hidden="true"></div></div>

      <!-- sign in / sign up -->
      <div class="acct-view" data-view="auth" hidden>
        <div class="acct-head">
          <h1 class="acct-title">حسابك في عرب راسلنج</h1>
          <p class="acct-sub">ادخل بحسابك، أو أنشئ حسابا جديدا في أقل من دقيقة.</p>
        </div>
        <div class="acct-tabs" role="tablist">
          <button type="button" role="tab" class="acct-tab is-on" data-tab="in" aria-selected="true">تسجيل الدخول</button>
          <button type="button" role="tab" class="acct-tab" data-tab="up" aria-selected="false">حساب جديد</button>
        </div>

        <form class="acct-form" data-form="in" novalidate>
          <label class="acct-field"><span>اسم المستخدم أو البريد</span>
            <input name="login" autocomplete="username" required dir="auto"></label>
          <label class="acct-field"><span>كلمة المرور</span>
            <span class="acct-pass"><input name="password" type="password" autocomplete="current-password" required><button type="button" class="acct-eye" aria-label="إظهار كلمة المرور"></button></span></label>
          <p class="acct-msg" role="status"></p>
          <button class="acct-btn" type="submit">دخول</button>
          <button type="button" class="acct-link" data-go="forgot">نسيت كلمة المرور؟</button>
        </form>

        <form class="acct-form" data-form="up" novalidate hidden>
          <div class="acct-names">
            <label class="acct-field"><span>الاسم الأول</span><input name="first_name" autocomplete="given-name" maxlength="20" required dir="auto"></label>
            <label class="acct-field"><span>الاسم الثاني</span><input name="last_name" autocomplete="family-name" maxlength="20" required dir="auto"></label>
          </div>
          <label class="acct-field"><span>اسم المستخدم</span>
            <input name="username" autocomplete="username" maxlength="20" required dir="auto">
            <small>من 3 إلى 20 حرفا، يبدأ بحرف. يظهر مع تعليقاتك.</small></label>
          <label class="acct-field"><span>البريد الإلكتروني</span>
            <input name="email" type="email" autocomplete="email" required dir="ltr"></label>
          <label class="acct-field"><span>كلمة المرور</span>
            <span class="acct-pass"><input name="password" type="password" autocomplete="new-password" required><button type="button" class="acct-eye" aria-label="إظهار كلمة المرور"></button></span>
            <span class="acct-meter" aria-hidden="true"><i></i></span><small class="acct-meter-tx">8 حروف على الأقل، فيها حروف وأرقام.</small></label>
          <div class="acct-field acct-cap"><span>اكتب الأرقام التي في الصورة</span>
            <div class="acct-cap-row">
              <span class="acct-cap-img" role="img" aria-label="رمز التحقق"></span>
              <button type="button" class="acct-cap-new" aria-label="رمز جديد" title="رمز جديد"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg></button>
              <input name="captcha" inputmode="numeric" autocomplete="off" maxlength="4" required dir="ltr" placeholder="••••">
            </div></div>
          <input class="acct-hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
          <p class="acct-note"><span>بإنشاء الحساب أنت توافق على</span> <a href="/terms/">شروط الاستخدام</a> <span>وعلى</span> <a href="/privacy/">سياسة الخصوصية</a>.</p>
          <p class="acct-msg" role="status"></p>
          <button class="acct-btn" type="submit">إنشاء الحساب</button>
        </form>
      </div>

      <!-- forgot -->
      <div class="acct-view" data-view="forgot" hidden>
        <button type="button" class="acct-back" data-go="auth">→ رجوع</button>
        <h1 class="acct-title">استرجاع الحساب</h1>
        <form class="acct-form" data-form="mail" novalidate>
          <p class="acct-sub">اكتب بريدك، وسنرسل لك رابطا لتغيير كلمة المرور.</p>
          <label class="acct-field"><span>البريد الإلكتروني</span><input name="email" type="email" autocomplete="email" required dir="ltr"></label>
          <p class="acct-msg" role="status"></p>
          <button class="acct-btn" type="submit">أرسل الرابط</button>
        </form>
      </div>

      <!-- a new password from the mailed link -->
      <div class="acct-view" data-view="reset" hidden>
        <h1 class="acct-title">كلمة مرور جديدة</h1>
        <form class="acct-form" data-form="reset" novalidate>
          <label class="acct-field"><span>كلمة المرور الجديدة</span>
            <span class="acct-pass"><input name="password" type="password" autocomplete="new-password" required><button type="button" class="acct-eye" aria-label="إظهار كلمة المرور"></button></span></label>
          <p class="acct-msg" role="status"></p>
          <button class="acct-btn" type="submit">حفظ ودخول</button>
        </form>
      </div>

      <!-- the member's own page -->
