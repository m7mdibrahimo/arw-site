<body style="font-family:sans-serif;padding:16px">
<p>Internal test page (INCIDENTS #48). ?u=native|top|mid|all loads units directly; add &sbx=1 to load each inside a sandboxed iframe that cannot navigate the page.</p>
<div id="slots"></div>
<script>
  var q = new URLSearchParams(location.search), u = q.get('u'), sbx = q.get('sbx') === '1';
  var UNITS = {
    native: { w: '100%', h: 320, html: '<script async="async" data-cfasync="false" src="https://pl31505250.profitableratecpmnetwork.com/f94fa42d357de8273771731d9656f234/invoke.js"><\/script><div id="container-f94fa42d357de8273771731d9656f234"><\/div>' },
    top: { w: 320, h: 50, html: '<script>atOptions={"key":"dda1cc4188deb500aa99df5341c8d852","format":"iframe","height":50,"width":320,"params":{}};<\/script><script src="https://www.highrevenueformat.com/dda1cc4188deb500aa99df5341c8d852/invoke.js"><\/script>' },
    mid: { w: 300, h: 250, html: '<script>atOptions={"key":"9ac40c2e2e5f5c809304a0eea96dbdff","format":"iframe","height":250,"width":300,"params":{}};<\/script><script src="https://www.highrevenueformat.com/9ac40c2e2e5f5c809304a0eea96dbdff/invoke.js"><\/script>' }
  };
  var list = u === 'all' ? ['top', 'mid', 'native'] : (UNITS[u] ? [u] : []);
  list.forEach(function (name) {
    var unit = UNITS[name];
    if (!sbx) { document.write('<div data-unit="' + name + '">' + unit.html + '<\/div>'); return; }
    var f = document.createElement('iframe');
    f.setAttribute('data-unit', name);
    // No allow-top-navigation: the ad can show and open its link in a new tab on click, never move this page.
    f.setAttribute('sandbox', 'allow-scripts allow-popups allow-popups-to-escape-sandbox allow-forms');
    f.setAttribute('scrolling', 'no');
    f.style.cssText = 'border:0;display:block;margin:12px auto;max-width:100%;width:' + (typeof unit.w === 'number' ? unit.w + 'px' : unit.w) + ';height:' + unit.h + 'px';
    f.srcdoc = '<!doctype html><html><head><meta charset="utf-8"><base target="_blank"><style>body{margin:0;display:flex;justify-content:center}</style></head><body>' + unit.html + '</body></html>';
    document.getElementById('slots').appendChild(f);
  });
</script>
