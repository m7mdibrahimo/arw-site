<section class="content">
<div class="wrap">

<div class="section-head reveal">
<h2 style="color:var(--gold);"><span class="dot" style="background:var(--gold)"></span>تصفح حسب السنة</h2>
<p>كل سلسلة تأخذك من أول حلقة تمهيدية وحتى العرض نفسه</p>
</div>

{% set years = [] %}
{% for s in collections.nostalgiaSeries %}
  {% if s.year and years.indexOf(s.year) == -1 %}{% set years = (years.push(s.year), years) %}{% endif %}
{% endfor %}
<div class="era-rail reveal" id="eraRail">
<button type="button" class="era-pill active" data-year="all">الكل</button>
{% for y in years %}
<button type="button" class="era-pill" data-year="{{ y }}">{{ y }}</button>
{% endfor %}
</div>

<div class="series-grid" id="seriesGrid">
{% for s in collections.nostalgiaSeries %}
<a class="series-card reveal" href="{{ ('/nostalgia/' + s.slug + '/') }}" data-year="{{ s.year }}">
<div class="series-poster">{{ s.title }}</div>
<div class="info">
<span class="cat">{{ s.count }} حلقة</span>
<h3>{{ s.title }}</h3>
<p>{{ s.year }} · نوستالجيا</p>
</div>
</a>
{% endfor %}
</div>

<p id="noYearResults" style="display:none; text-align:center; color:var(--muted); padding:40px 0;">لا توجد سلاسل لهذه السنة بعد.</p>

<script>
(function(){
var rail = document.getElementById('eraRail');
if(!rail) return;
var pills = rail.querySelectorAll('.era-pill');
var cards = document.querySelectorAll('.series-card');
var noResults = document.getElementById('noYearResults');
rail.addEventListener('click', function(e){
var btn = e.target.closest('.era-pill');
if(!btn) return;
pills.forEach(function(p){ p.classList.remove('active'); });
btn.classList.add('active');
var year = btn.getAttribute('data-year');
var visibleCount = 0;
cards.forEach(function(card){
var match = (year === 'all') || (card.getAttribute('data-year') === year);
card.style.display = match ? '' : 'none';
if(match) visibleCount++;
});
noResults.style.display = visibleCount === 0 ? 'block' : 'none';
});
})();
</script>

