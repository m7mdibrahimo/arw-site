---
pagination:
  data: collections.nostalgiaSeries
  size: 1
  alias: series
permalink: "/nostalgia/{{ series.slug }}/index.html"
eleventyComputed:
  seriesSlug: "{{ series.slug }}"
---
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
{% include "adsense.njk" %}
<script>if(window.location.hostname.includes('pages.dev')){window.location.replace('https://arab-wrestling.com'+window.location.pathname+window.location.search+window.location.hash);}</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="apple-touch-icon" href="/favicon.png">
<title>{{ series.title }} | نوستالجيا | عرب راسلنج</title>
<meta name="description" content="{{ series.title }} مترجم بالكامل: {{ series.count }} حلقة من العروض الأسبوعية التي أسّست للعرض الشهري، مرتبة بالترتيب الزمني.">
<link rel="canonical" href="https://arab-wrestling.com/nostalgia/{{ series.slug }}/">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800;900&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/notif.css">
<style>
:root{
--bg: #faf7f0; --card: #ffffff; --ink: #1e2530; --muted: #6c7383; --line: #ece6d8;
--teal: #0e9594; --teal-soft: #e3f5f3; --coral: #ff6f59; --coral-soft: #ffece8;
--gold: #f2a53c; --gold-soft: #fdf1de; --violet: #7c6ee8;
}
html.arw-dark{
--bg:#0d0f13; --card:#171a20; --ink:#eef1f6; --muted:#9aa2b0; --line:rgba(255,255,255,.1);
--teal:#1cb5b3; --teal-soft:rgba(28,181,179,.15); --coral:#ff8570; --coral-soft:rgba(255,133,112,.15);
--gold:#f4b352; --gold-soft:rgba(244,179,82,.15); --violet:#9a8ff0;
}
*{box-sizing:border-box; margin:0; padding:0;}
html{ scroll-behavior:smooth; background-color:var(--bg); }
body{ background:var(--bg); color:var(--ink); font-family:'Tajawal',sans-serif; line-height:1.75; transition:background-color .3s ease, color .3s ease; }
h1,h2,h3,.brand{ font-family:'Cairo',sans-serif; font-weight:900; }
header{ position:sticky; top:0; z-index:50; background:var(--bg); backdrop-filter:blur(8px); border-bottom:1px solid var(--line); }
.nav{ max-width:1180px; margin:0 auto; padding:16px 24px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px;}
.brand{ font-weight:900; font-size:21px; text-decoration:none; color:var(--ink); white-space:nowrap; }
.brand span{ color:var(--teal); }
.nav ul{ list-style:none; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
.nav a.navlink{ color:var(--ink); text-decoration:none; font-weight:700; font-size:14px; padding:9px 16px; border-radius:999px; transition:all 0.25s cubic-bezier(0.34,1.56,0.64,1); }
.nav a.navlink:hover{ background:var(--teal-soft); color:var(--teal); transform:translateY(-2px); }
.nav a.navlink.active{ background:#1e2530; color:#fff; }
html.arw-dark .nav a.navlink.active{ background:#fff; color:#1e2530; }
.nav a.navlink.support-btn{ display:inline-flex; align-items:center; gap:6px; background:linear-gradient(135deg, var(--coral), var(--gold)); color:#fff !important; border:none; box-shadow:0 4px 14px rgba(255,111,89,0.35); animation:support-pulse 2.6s ease-in-out infinite; }
.nav a.navlink.support-btn:hover{ background:linear-gradient(135deg, var(--gold), var(--coral)); color:#fff !important; transform:translateY(-2px) scale(1.04); box-shadow:0 8px 20px rgba(255,111,89,0.45); animation-play-state:paused; }
.nav a.navlink.support-btn svg{ flex-shrink:0; }
@keyframes support-pulse{ 0%,100%{ box-shadow:0 4px 14px rgba(255,111,89,0.35); } 50%{ box-shadow:0 4px 22px rgba(255,111,89,0.65); } }
.nav-dropdown{ position:relative; display:inline-flex; align-items:center; }
.dropdown-menu{ display:flex !important; flex-direction:column; gap:4px !important; position:absolute; top:calc(100% + 6px); left:50%; right:auto; transform:translateX(-50%) translateY(-6px) scale(0.97); min-width:175px; background:var(--card); border:1px solid var(--line); border-radius:14px; padding:8px; box-shadow:0 16px 36px -12px rgba(0,0,0,.25); list-style:none; opacity:0; visibility:hidden; transition:all 0.22s cubic-bezier(0.16,1,0.3,1); z-index:60; transform-origin:top center; pointer-events:none; }
.dropdown-menu::before{ content:''; position:absolute; top:-14px; left:0; right:0; height:14px; background:transparent; display:block; }
.nav-dropdown:hover .dropdown-menu, .nav-dropdown:focus-within .dropdown-menu{ opacity:1; visibility:visible; transform:translateX(-50%) translateY(0) scale(1); pointer-events:auto; }
.dropdown-menu li{ list-style:none; width:100%; margin:0; padding:0; }
.dropdown-menu a.drop-item{ display:flex; align-items:center; gap:10px; width:100%; box-sizing:border-box; padding:9px 12px; border-radius:10px; color:var(--ink); text-decoration:none; font-weight:800; font-size:13.5px; border:1px solid transparent; transition:all 0.2s cubic-bezier(0.16,1,0.3,1); }
.drop-dot{ width:8px; height:8px; border-radius:50%; flex-shrink:0; transition:transform 0.2s ease; }
.drop-item:hover .drop-dot{ transform:scale(1.4); }
.drop-wwe .drop-dot{ background:#c73b2c; } .drop-wwe:hover, .drop-wwe.active{ background:rgba(199,59,44,.12) !important; color:#c73b2c !important; border-color:rgba(199,59,44,.25) !important; transform:translateX(-3px); }
.drop-aew .drop-dot{ background:#d4a017; } .drop-aew:hover, .drop-aew.active{ background:rgba(212,160,23,.15) !important; color:#b58509 !important; border-color:rgba(212,160,23,.3) !important; transform:translateX(-3px); }
.drop-tna .drop-dot{ background:#8a5fe0; } .drop-tna:hover, .drop-tna.active{ background:rgba(138,95,224,.14) !important; color:#7c42d6 !important; border-color:rgba(138,95,224,.28) !important; transform:translateX(-3px); }
.drop-roh .drop-dot{ background:#3866c7; } .drop-roh:hover, .drop-roh.active{ background:rgba(44,102,199,.14) !important; color:#2358b5 !important; border-color:rgba(44,102,199,.28) !important; transform:translateX(-3px); }
.drop-mma .drop-dot{ background:#e07a2c; } .drop-mma:hover, .drop-mma.active{ background:rgba(224,122,44,.14) !important; color:#c45b10 !important; border-color:rgba(224,122,44,.28) !important; transform:translateX(-3px); }
.drop-indie .drop-dot{ background:#1f8a72; } .drop-indie:hover, .drop-indie.active{ background:rgba(31,138,114,.14) !important; color:#0f705b !important; border-color:rgba(31,138,114,.28) !important; transform:translateX(-3px); }
.site-search{ flex:1; min-width:140px; max-width:420px; display:flex; align-items:center; background:var(--card); border:1px solid var(--line); border-radius:999px; padding:6px 8px 6px 16px; transition:all 0.3s cubic-bezier(0.16,1,0.3,1); }
.site-search:focus-within{ border-color:var(--teal); box-shadow:0 0 0 4px var(--teal-soft), 0 8px 24px -8px rgba(14,149,148,0.25); transform:translateY(-1px); }
.site-search input{ flex:1; border:none; outline:none; background:transparent; font-family:'Tajawal',sans-serif; font-size:14px; color:var(--ink); padding:6px 4px; }
.site-search input::placeholder{ color:var(--muted); }
.site-search button{ border:none; background:var(--teal); color:#fff; width:34px; height:34px; border-radius:50%; cursor:pointer; display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:transform 0.25s cubic-bezier(0.34,1.56,0.64,1), background-color 0.2s ease; }
.site-search button:hover{ transform:scale(1.12) rotate(8deg); background:#0b7c7b; }
.theme-toggle{ width:40px; height:40px; border-radius:50%; border:1px solid var(--line); background:var(--card); color:var(--ink); display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all 0.35s cubic-bezier(0.34,1.56,0.64,1); }
.theme-toggle:hover{ transform:rotate(45deg) scale(1.1); border-color:var(--teal); color:var(--teal); }
.theme-toggle .icon-sun{ display:none; }
html.arw-dark .theme-toggle .icon-moon{ display:none; }
html.arw-dark .theme-toggle .icon-sun{ display:block; }
.telegram-btn{ width:40px; height:40px; border-radius:50%; border:1px solid var(--line); background:var(--card); color:var(--ink); display:flex; align-items:center; justify-content:center; text-decoration:none; flex-shrink:0; transition:all 0.35s cubic-bezier(0.34,1.56,0.64,1); }
.telegram-btn:hover{ transform:scale(1.1); border-color:var(--teal); color:var(--teal); }
.utility-row{ display:inline-flex; align-items:center; gap:8px; }
@media (max-width:860px){
.nav{ padding:14px 16px 16px; gap:10px; flex-wrap:wrap; justify-content:center; }
.brand{ font-size:19px; flex-basis:auto; }
.site-search{ order:2; flex-basis:100%; max-width:none; min-width:0; }
#navMenu{
order:3; flex-basis:100%; width:100%;
display:flex; flex-wrap:wrap; align-items:center; justify-content:center;
gap:8px 8px; padding-top:2px;
}
#navMenu li{ display:inline-flex; }
#navMenu a.navlink{ font-size:13px; padding:8px 14px; }
#navMenu .theme-toggle{ width:38px; height:38px; }
}
@media (min-width:861px){
.nav{ flex-wrap:nowrap; }
#navMenu{ flex-wrap:nowrap; overflow-x:auto; scrollbar-width:none; -ms-overflow-style:none; }
#navMenu::-webkit-scrollbar{ display:none; }
#navMenu li{ flex-shrink:0; }
}
@media (min-width:861px) and (max-width:1400px){
.nav{ gap:10px; padding:14px 18px; }
#navMenu{ gap:4px; }
.nav a.navlink, #navMenu a.navlink{ font-size:13px; padding:8px 13px; }
}
.wrap{ max-width:1180px; margin:0 auto; }
section.content{ padding:44px 24px 70px; }
footer{ padding:40px 24px; text-align:center; color:var(--muted); font-size:13px; border-top:1px solid var(--line); }
.social-row{ display:flex; justify-content:center; gap:12px; margin-bottom:16px; }
.social-row a{ width:38px; height:38px; border-radius:50%; background:var(--card); border:1px solid var(--line); display:flex; align-items:center; justify-content:center; color:var(--ink); transition:all 0.3s cubic-bezier(0.34,1.56,0.64,1); }
.social-row a:hover{ background:var(--teal); color:#fff; border-color:var(--teal); transform:translateY(-4px) scale(1.12); box-shadow:0 8px 16px rgba(14,149,148,0.3); }
.reveal{ opacity:1; transform:none; }
.reveal.reveal-hidden{ opacity:0; transform:translateY(48px); transition:none !important; }
.reveal.is-visible{ opacity:1; transform:translateY(0); transition:opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1); }

.crumb{ padding:18px 24px 0; font-size:13px; color:var(--muted); }
.crumb .wrap{ display:flex; gap:8px; align-items:center; }
.crumb a{ color:var(--muted); text-decoration:none; }
.crumb a:hover{ color:var(--teal); }

.shero{ position:relative; margin:20px 24px 0; border-radius:24px; overflow:hidden;
  background: linear-gradient(180deg, rgba(10,12,16,.35) 0%, rgba(10,12,16,.88) 100%), linear-gradient(135deg,#c73b2c,#5c150c);
  padding:64px 40px; max-width:1132px; margin-inline:auto; }
.shero-inner{ position:relative; max-width:640px; }
.shero .eyebrow{ display:inline-flex; align-items:center; gap:8px; background:rgba(255,255,255,.14); backdrop-filter:blur(6px); color:#fff; font-weight:700; font-size:13px; padding:8px 18px; border-radius:999px; margin-bottom:22px; border:1px solid rgba(255,255,255,.25); }
.shero h1{ font-size:clamp(30px,4.6vw,48px); line-height:1.18; color:#fff; margin-bottom:14px; letter-spacing:-.5px; }
.shero p{ color:rgba(255,255,255,.85); font-size:15px; max-width:480px; margin-bottom:26px; }
.shero-stats{ display:flex; gap:28px; }
.shero-stats div p:first-child{ font-family:'Cairo',sans-serif; font-weight:900; font-size:22px; color:#fff; margin:0; }
.shero-stats div p:last-child{ font-size:12px; color:rgba(255,255,255,.7); margin-top:2px; }

.section-head{ margin:52px 0 26px; display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; }
.section-head h2{ font-size:clamp(20px,2.6vw,26px); display:flex; align-items:center; gap:12px; }
.section-head h2 .dot{ width:10px; height:10px; border-radius:50%; display:inline-block; }
.section-head p{ color:var(--muted); font-size:13px; }

.timeline{ position:relative; max-width:760px; }
.timeline::before{ content:''; position:absolute; right:27px; top:8px; bottom:8px; width:2px; background:linear-gradient(to bottom, var(--line), var(--gold) 94%); }
.ep-row{ position:relative; display:flex; align-items:center; gap:18px; padding:9px 0; }
.ep-num{ flex-shrink:0; width:56px; height:56px; border-radius:50%; background:var(--card); border:1px solid var(--line); display:flex; align-items:center; justify-content:center; font-family:'Cairo',sans-serif; font-weight:900; font-size:16px; color:var(--muted); z-index:1; transition:all .3s cubic-bezier(0.34,1.56,0.64,1); }
.episode-card{ flex:1; background:var(--card); border:1px solid var(--line); border-radius:16px; overflow:hidden; display:flex; align-items:center; text-decoration:none; color:var(--ink); transition:transform 0.35s cubic-bezier(0.34,1.56,0.64,1), box-shadow 0.35s ease, border-color 0.3s ease; }
.episode-card:hover{ transform:translateX(-6px) translateY(-2px); box-shadow:0 16px 30px -16px rgba(14,149,148,.28); border-color:var(--teal); }
.ep-row:hover .ep-num{ border-color:var(--teal); color:var(--teal); transform:scale(1.06); }
.ep-thumb{ width:96px; height:76px; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-family:'Cairo',sans-serif; font-weight:900; font-size:12px; color:#fff; text-align:center; line-height:1.3; background-size:cover; background-position:center; }
.ep-body{ padding:14px 18px; flex:1; }
.ep-body h3{ font-size:14.5px; font-weight:700; margin-bottom:4px; }
.ep-body .foot{ font-size:12px; color:var(--muted); display:flex; gap:10px; align-items:center; }
.ep-badge{ font-size:10px; font-weight:800; padding:2px 9px; border-radius:999px; background:var(--teal-soft); color:var(--teal); }
.ep-row.main{ padding-top:20px; }
.ep-row.main .ep-num{ width:64px; height:64px; background:var(--gold); border-color:var(--gold); color:#3a2606; font-size:18px; }
.ep-row.main .episode-card{ border:1.5px solid var(--gold); background:linear-gradient(120deg, var(--gold-soft), var(--card) 60%); }
.ep-row.main .ep-thumb{ width:120px; height:96px; }
.ep-row.main .ep-body h3{ font-size:16.5px; }
.ep-row.main .ep-badge{ background:var(--gold-soft); color:var(--gold); }

@media (max-width:640px){
  .shero{ padding:44px 24px; border-radius:18px; }
  .ep-thumb{ display:none; }
  .timeline::before{ right:21px; }
  .ep-num{ width:44px; height:44px; font-size:13px; }
  .ep-row.main .ep-num{ width:52px; height:52px; }
}
</style>
</head>
<body>
<header>
<div class="nav">
<a class="brand" href="/">عرب <span>راسلنج</span></a>
<form class="site-search" action="/search/" method="get">
<input type="text" name="q" placeholder="اكتب ما تريد البحث عنه...">
<button aria-label="بحث" type="submit"><svg fill="none" height="16" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21L16.65 16.65" stroke="currentColor" stroke-linecap="round" stroke-width="2"/></svg></button>
</form>
<ul id="navMenu">
<li><a class="navlink" href="/">الرئيسية</a></li>
<li class="nav-dropdown">
<a class="navlink" href="/federations/">الاتحادات</a>
<ul class="dropdown-menu">
<li><a href="/federation/wwe/" class="drop-item drop-wwe"><span class="drop-dot"></span><span>WWE</span></a></li>
<li><a href="/federation/aew/" class="drop-item drop-aew"><span class="drop-dot"></span><span>AEW</span></a></li>
<li><a href="/federation/tna/" class="drop-item drop-tna"><span class="drop-dot"></span><span>TNA</span></a></li>
<li><a href="/federation/roh/" class="drop-item drop-roh"><span class="drop-dot"></span><span>ROH</span></a></li>
<li><a href="/federation/mma/" class="drop-item drop-mma"><span class="drop-dot"></span><span>MMA</span></a></li>
<li><a href="/federation/indie/" class="drop-item drop-indie"><span class="drop-dot"></span><span>INDIE</span></a></li>
</ul>
</li>
<li><a class="navlink" href="/shows/">عروض المصارعة</a></li>
<li><a class="navlink" href="/recaps/">ملخصات العروض</a></li>
<li><a class="navlink" href="/news/">الأخبار</a></li><li><a class="navlink active" href="/nostalgia/">نوستالجيا</a></li>
<li><a class="navlink support-btn" href="/support/"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 21s-6.716-4.35-9.428-8.06C.688 10.2 1.2 6.6 4.1 4.9c2.3-1.35 5.1-.7 6.6 1.2.5.6.9 1.3 1.3 2 .4-.7.8-1.4 1.3-2 1.5-1.9 4.3-2.55 6.6-1.2 2.9 1.7 3.412 5.3 1.528 8.04C18.716 16.65 12 21 12 21Z"/></svg><span>ادعم الموقع</span></a></li>
<li class="utility-row">
<button aria-label="تبديل الوضع الليلي" class="theme-toggle" id="arwThemeToggle" type="button">
<svg class="icon-moon" fill="none" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79Z" fill="currentColor"/></svg>
<svg class="icon-sun" fill="none" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" fill="currentColor" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke="currentColor" stroke-linecap="round" stroke-width="2"/></svg>
</button>
<a aria-label="قناة التليجرام" class="telegram-btn" href="https://t.me/arab_wrestling" target="_blank" rel="noopener" title="قناة التليجرام الرسمية">
<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M20.665 3.717l-17.73 6.837c-1.21.486-1.203 1.161-.222 1.462l4.552 1.42 10.532-6.645c.498-.303.953-.14.579.192l-8.533 7.701h-.002l-.002.001-.314 4.692c.46 0 .663-.211.921-.46l2.211-2.15 4.599 3.397c.848.467 1.457.227 1.668-.785l3.019-14.228c.309-1.239-.473-1.8-1.282-1.434z"/></svg>
</a>
</li>
</ul>
</div>
</header>

<div class="crumb"><div class="wrap"><a href="/">الرئيسية</a> / <a href="/nostalgia/">نوستالجيا</a> / <span style="color:var(--ink);">{{ series.title }}</span></div></div>

<div class="shero">
<div class="shero-inner">
<span class="eyebrow">🕰️ موسم نوستالجيا {{ series.year }}</span>
<h1>{{ series.title }}</h1>
<p>المسار كاملًا من أول عرض أسبوعي وحتى ليلة العرض الشهري — جميع الحلقات مترجمة بالكامل.</p>
<div class="shero-stats">
<div><p>{{ series.count }}</p><p>حلقات</p></div>
<div><p>{{ series.year }}</p><p>السنة</p></div>
<div><p>1</p><p>عرض رئيسي</p></div>
</div>
</div>
</div>

<section class="content">
<div class="wrap">
<div class="section-head">
<div><h2 style="color:var(--coral);"><span class="dot" style="background:var(--coral)"></span>خط الأحداث</h2><p>مرتبة حسب التسلسل الدرامي، لا حسب تاريخ النشر</p></div>
</div>

<div class="timeline">
{% for ep in series.episodes %}
<div class="ep-row{% if ep.isMain %} main{% endif %}">
<div class="ep-num">{{ loop.index }}</div>
<a class="episode-card" href="{{ ep.url | cleanUrl }}">
<div class="ep-thumb" {% if ep.image %}style="background-image:url('{{ ep.image }}');"{% else %}style="background:linear-gradient(135deg,#c73b2c,#5c150c);"{% endif %}>{% if not ep.image %}{{ ep.title }}{% endif %}</div>
<div class="ep-body">
<h3>{{ ep.headline or ep.title }}</h3>
<div class="foot"><span class="ep-badge">{% if ep.isMain %}نهاية المسلسل{% else %}مترجم{% endif %}</span><span>{{ ep.event_date | date }}</span></div>
</div>
</a>
</div>
{% endfor %}
</div>

</div>
</section>

