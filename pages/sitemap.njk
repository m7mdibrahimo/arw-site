---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- set latestDate = collections.allContent[0].date.toISOString().slice(0, 10) %}
  <url>
    <loc>https://arab-wrestling.com/</loc>
    <lastmod>{{ latestDate }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://arab-wrestling.com/shows/</loc>
    <lastmod>{{ latestDate }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://arab-wrestling.com/recaps/</loc>
    <lastmod>{{ latestDate }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://arab-wrestling.com/news/</loc>
    <lastmod>{{ latestDate }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://arab-wrestling.com/federations/</loc>
    <lastmod>{{ latestDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://arab-wrestling.com/tags/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://arab-wrestling.com/support/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://arab-wrestling.com/privacy/</loc>
    <changefreq>yearly</changefreq>
    <priority>0.2</priority>
  </url>
  {% for fed in ["wwe", "aew", "tna", "roh", "mma", "indie"] %}
  <url>
    <loc>https://arab-wrestling.com/federation/{{ fed }}/</loc>
    <lastmod>{{ latestDate }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}
  {% for item in collections.allContent %}
  <url>
    <loc>https://arab-wrestling.com{{ item.url | cleanUrl }}</loc>
    <lastmod>{{ item.date.toISOString().slice(0, 10) }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}
  {% for tagObj in collections.tagList %}
  {% if tagObj.count >= 3 %}
  <url>
    <loc>https://arab-wrestling.com/tag/{{ tagObj.slug }}/</loc>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>
  {% endif %}
  {% endfor %}
</urlset>
