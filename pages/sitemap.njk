---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1">
{%- set latestDate = collections.allContent[0].date.toISOString().slice(0, 10) if (collections.allContent and collections.allContent.length) else "2026-09-18" %}
{%- set latestNewsDate = collections.news[0].date.toISOString().slice(0, 10) if (collections.news and collections.news.length) else latestDate %}
{%- set latestShowsDate = collections.shows[0].date.toISOString().slice(0, 10) if (collections.shows and collections.shows.length) else latestDate %}
{%- set latestNostalgiaDate = collections.nostalgia[0].date.toISOString().slice(0, 10) if (collections.nostalgia and collections.nostalgia.length) else latestDate %}
  <url>
    <loc>https://arab-wrestling.com/</loc>
    <lastmod>{{ latestDate }}</lastmod>
    <changefreq>always</changefreq>
    <priority>1.0</priority>
  </url>
  {#- Sitelinks (owner, 2026-11-09): the four sections under the site name — عروض المصارعة /shows/، مكتبة العروض /library/، الأخبار /news/، نوستالجيا /nostalgia/ — carry 0.9, right under the home page. /federations/, /about/, /apps/ and /support/ are noindex now, so they are not listed (a sitemap never names a noindex page). -#}
  <url>
    <loc>https://arab-wrestling.com/news/</loc>
    <lastmod>{{ latestNewsDate }}</lastmod>
    <changefreq>hourly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://arab-wrestling.com/shows/</loc>
    <lastmod>{{ latestShowsDate }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://arab-wrestling.com/nostalgia/</loc>
    <lastmod>{{ latestNostalgiaDate }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://arab-wrestling.com/tags/</loc>
    <lastmod>{{ latestDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://arab-wrestling.com/contact/</loc>
    <lastmod>2026-09-01</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  <url>
    <loc>https://arab-wrestling.com/privacy/</loc>
    <lastmod>2026-09-01</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.2</priority>
  </url>
  <url>
    <loc>https://arab-wrestling.com/dmca/</loc>
    <lastmod>2026-09-01</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.2</priority>
  </url>
  <url>
    <loc>https://arab-wrestling.com/terms/</loc>
    <lastmod>2026-09-01</lastmod>
    <changefreq>yearly</changefreq>
    <priority>0.2</priority>
  </url>
  {% for fed in ["wwe", "aew", "njpw", "tna", "roh", "mma", "indie"] %}
  <url>
    <loc>https://arab-wrestling.com/federation/{{ fed }}/</loc>
    <lastmod>{{ latestDate }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.7</priority>
  </url>
  {% endfor %}
  {# The show library and each program's page («عرض الرو الأخير مترجم») were missing from the sitemap (INCIDENTS #275) #}
  <url>
    <loc>https://arab-wrestling.com/library/</loc>
    <lastmod>{{ latestDate }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  {% for v in collections.libraryViews %}{% if v.promo %}
  <url>
    <loc>https://arab-wrestling.com{{ v.href }}</loc>
    <lastmod>{{ v.promo.latest.timestamp | isoDay }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.8</priority>
  </url>
  {% endif %}{% endfor %}
  {% for prog in collections.library %}
  <url>
    <loc>https://arab-wrestling.com/library/{{ prog.slug }}/</loc>
    <lastmod>{{ prog.latest.timestamp | isoDay }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  {% endfor %}
  {% for series in collections.nostalgiaSeries %}
  <url>
    <loc>https://arab-wrestling.com/nostalgia/{{ series.slug }}/</loc>
    <lastmod>{{ latestNostalgiaDate }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}
  {% for item in collections.allContent %}
  <url>
    <loc>https://arab-wrestling.com{{ item.url | cleanUrl }}</loc>
    <lastmod>{{ item.date.toISOString().slice(0, 10) }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
    {% if item.data.image %}
    <image:image>
      <image:loc>{{ item.data.image | absUrl }}</image:loc>
      <image:title>{{ (item.data.headline or item.data.title) | escape }}</image:title>
    </image:image>
    {% endif %}
  </url>
  {% endfor %}
</urlset>
