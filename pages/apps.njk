<script>
  // تفعيل التبديل بين الوضع الليلي والنهاري
  (function(){
    var saved = null;
    try{ saved = localStorage.getItem('arw-theme'); }catch(e){}
    if(saved !== 'dark' && saved !== 'light'){
      try{
        var m = document.cookie.match(/(?:^|; )arw-theme=([^;]*)/);
        if(m) saved = decodeURIComponent(m[1]);
      }catch(e){}
    }
    if(saved === 'dark'){ document.documentElement.classList.add('arw-dark'); }
  })();
  var themeBtn = document.getElementById('arwThemeToggle');
  if(themeBtn){
    themeBtn.addEventListener('click', function(){
      var isDark = document.documentElement.classList.toggle('arw-dark');
      var val = isDark ? 'dark' : 'light';
      try{ localStorage.setItem('arw-theme', val); }catch(e){}
      document.cookie = 'arw-theme=' + val + ';path=/;max-age=31536000';
    });
  }

  // كاشف نظام التشغيل التلقائي الذكي
  (function(){
    var ua = navigator.userAgent || navigator.vendor || window.opera;
    var osTitle = "أجهزة الكمبيوتر والهواتف";
    var osIcon = "💻";
    var btnText = "تحميل التطبيق الآن";
    var downloadUrl = "#all-platforms";
    var cardId = "";

    if (/harmonyos|huawei|honor/i.test(ua)) {
      osTitle = "هاتف هواوي (HarmonyOS)";
      osIcon = "🌺";
      btnText = "تحميل مباشر لهواوي (5.8 MB)";
      downloadUrl = "/assets/downloads/ArabWrestling.hap";
      cardId = "card-harmonyos";
    } else if (/android/i.test(ua)) {
      osTitle = "هاتف أندرويد (Android)";
      osIcon = "🤖";
      btnText = "تحميل مباشر للأندرويد (5.9 MB)";
      downloadUrl = "/assets/downloads/ArabWrestling-v1.0.1.apk?v=1.0.1";
      cardId = "card-android";
    } else if (/iPad|iPhone|iPod/.test(ua) && !window.MSStream) {
      osTitle = "آيفون أو آيباد (iOS)";
      osIcon = "📱";
      btnText = "طريقة تثبيت الآيفون";
      downloadUrl = "#install-guide";
      cardId = "card-ios";
    } else if (/Macintosh|Mac OS X/i.test(ua)) {
      osTitle = "جهاز ماك (macOS)";
      osIcon = "🍏";
      btnText = "تحميل مباشر للماك (9.7 MB)";
      downloadUrl = "/assets/downloads/ArabWrestling.dmg";
      cardId = "card-macos";
    } else if (/Windows/i.test(ua)) {
      osTitle = "نظام ويندوز (Windows)";
      osIcon = "🪟";
      btnText = "تحميل مثبت الويندوز (3.7 MB)";
      downloadUrl = "/assets/downloads/ArabWrestling.msi";
      cardId = "card-windows";
    } else if (/Linux/i.test(ua)) {
      osTitle = "نظام لينكس (Linux)";
      osIcon = "🐧";
      btnText = "تحميل حزمة لينكس (5.2 MB)";
      downloadUrl = "/assets/downloads/ArabWrestling.deb";
      cardId = "card-linux";
    }

    var titleEl = document.getElementById('detectedOsTitle');
    var iconEl = document.getElementById('detectedOsIcon');
    var btnEl = document.getElementById('detectedOsBtn');
    var btnTextEl = document.getElementById('detectedOsBtnText');

    if(titleEl) titleEl.textContent = osTitle;
    if(iconEl) iconEl.textContent = osIcon;
    if(btnTextEl) btnTextEl.textContent = btnText;
    if(btnEl) {
      btnEl.href = downloadUrl;
      if(downloadUrl.endsWith('.apk') || downloadUrl.endsWith('.hap') || downloadUrl.endsWith('.dmg') || downloadUrl.endsWith('.msi') || downloadUrl.endsWith('.deb')){
        btnEl.setAttribute('download', '');
      }
    }

    if(cardId){
      var targetCard = document.getElementById(cardId);
      if(targetCard){
        targetCard.classList.add('featured');
      }
    }
  })();

  // فلترة المنصات عبر الأزرار
  function filterPlatforms(type, btn) {
    document.querySelectorAll('.filter-pill').forEach(function(b){ b.classList.remove('active'); });
    btn.classList.add('active');
    var cards = document.querySelectorAll('.fed-card[data-category]');
    cards.forEach(function(card){
      if (type === 'all' || card.getAttribute('data-category') === type) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  }

  // تبديل تبويبات دليل التثبيت
  function switchGuide(id, btn){
    document.querySelectorAll('.step-tab-btn').forEach(function(b){ b.classList.remove('active'); });
    document.querySelectorAll('.step-content').forEach(function(c){ c.classList.remove('active'); });
    btn.classList.add('active');
    var target = document.getElementById(id);
    if(target) target.classList.add('active');
  }

  function showIosGuide(){
    var iosBtn = document.querySelector(".step-tab-btn[onclick*='guide-ios']");
    if(iosBtn){
      switchGuide('guide-ios', iosBtn);
      var guideEl = document.getElementById('install-guide');
      if(guideEl) guideEl.scrollIntoView({ behavior: 'smooth' });
    }
  }

  // تفعيل أنيميشن الصعود والنزول للبطاقات والخانات عند التمرير (Scroll Reveal مطابق لباقي الموقع)
  if('IntersectionObserver' in window){
    const io = new IntersectionObserver((entries)=>{
      entries.forEach(e=>{
        if(e.isIntersecting){ e.target.classList.remove('reveal-hidden'); e.target.classList.add('is-visible'); }
        else { e.target.classList.remove('is-visible'); e.target.classList.add('reveal-hidden'); }
      });
    }, { threshold:.12 });
    document.querySelectorAll('.reveal').forEach(el=>{
      el.classList.add('reveal-hidden');
      io.observe(el);
    });
  }

  // إخفاء وإظهار الهيدر عند التمرير للهواتف (يصعد للأعلى عند التمرير لأسفل، وينزل للأسفل عند التمرير لأعلى)
  (function(){
    var header = document.querySelector('header');
    if(!header) return;
    var lastY = window.pageYOffset || document.documentElement.scrollTop || window.scrollY || 0;
    var ticking = false;

    function onScroll(){
      var currentY = window.pageYOffset || document.documentElement.scrollTop || window.scrollY || 0;
      if(window.innerWidth <= 1250 || window.matchMedia('(max-width: 1250px)').matches){
        if(currentY > lastY && currentY > 60){
          header.classList.add('header-hidden');
        } else if(currentY < lastY){
          header.classList.remove('header-hidden');
        }
      } else {
        header.classList.remove('header-hidden');
      }
      lastY = currentY;
      ticking = false;
    }

    window.addEventListener('scroll', function(){
      if(!ticking){
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, {passive:true});

    document.addEventListener('scroll', function(){
      if(!ticking){
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, {passive:true});
  })();
</script>
