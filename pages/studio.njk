<!doctype html>
<html lang="ar" dir="rtl" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#fffdf8">
  <title>لوحة التحكم — عرب راسلنج</title>
  <link rel="icon" type="image/png" href="/favicon.png?v=3">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3">
  <link rel="manifest" href="/admin/manifest.webmanifest">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;500;600;700;800;900&display=swap" onload="this.onload=null;this.rel='stylesheet'"><noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic:wght@400;500;600;700;800;900&display=swap"></noscript>
  <script>
    // INCIDENTS #1425: right after a deploy this page can reach a machine still on the old build, whose answer for the
    // new build's files is «not found». The file is asked for again (1s, 3s, 6s, 12s) at a fresh address, so neither
    // that machine's answer nor a cached «not found» can leave the panel without its styles or its code.
    window.arwRetry = function (el) {
      var n = +(el.getAttribute('data-try') || 0);
      if (n >= 4) return;
      var css = el.tagName === 'LINK', attr = css ? 'href' : 'src';
      var base = el.getAttribute(attr).split('?')[0];
      setTimeout(function () {
        var copy = document.createElement(el.tagName);
        if (css) copy.rel = 'stylesheet'; else copy.type = 'module';
        copy.setAttribute('data-try', String(n + 1));
        copy.onerror = function () { window.arwRetry(copy); };
        copy.setAttribute(attr, base + '?r=' + Date.now());
        el.parentNode.insertBefore(copy, el.nextSibling);
        el.parentNode.removeChild(el);
      }, [1000, 3000, 6000, 12000][n]);
    };
  </script>
  <link rel="stylesheet" href="/admin/{{ studioVersion }}/studio.css" onerror="arwRetry(this)">
  <link rel="modulepreload" href="/admin/{{ studioVersion }}/js/app.js">
  <script>
    // Saved theme before the first paint (no light flash)
    try { document.documentElement.dataset.theme = localStorage.getItem('arw_studio_theme') || 'light'; } catch (e) {}
  </script>
</head>
<body>
  <div id="app"><div class="boot"><img src="/assets/brand-logo.png?v=2" alt=""><div class="spinner"></div></div></div>
  <noscript>اللوحة محتاجة جافاسكربت.</noscript>
  <script type="module" src="/admin/{{ studioVersion }}/js/app.js" onerror="arwRetry(this)"></script>
</body>
</html>
