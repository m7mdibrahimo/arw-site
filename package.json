{
  "name": "arab-wrestling-site",
  "version": "1.0.0",
  "scripts": {
    "postinstall": "node scripts/patch-eleventy.js",
    "dev": "tsx server.ts",
    "build": "node --stack-size=4096 ./node_modules/@11ty/eleventy/cmd.js && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "watch:news": "tsx scripts/fightful-watcher.ts",
    "watch:news:daemon": "tsx scripts/fightful-watcher.ts --daemon",
    "update:feed": "tsx scripts/update-feed.ts",
    "video:news": "tsx scripts/generate-news-video.ts",
    "test:publishing": "tsx --test tests/publishing.test.mts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "gray-matter": "^4.0.3",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-img": "^3.1.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.25.0",
    "hyperframes": "^0.8.46",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2"
  }
}
