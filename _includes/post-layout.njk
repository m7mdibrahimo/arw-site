{% set isNews = (page.inputPath and "content/news" in page.inputPath) %}
{% set isShow = (page.inputPath and "content/shows" in page.inputPath) %}

<div class="hero" id="top"{% if image %} style="background: linear-gradient(180deg, rgba(10,12,16,.65) 0%, rgba(10,12,16,.82) 55%, var(--bg) 100%), url('{% optImg image, '' %}') center 30%/cover no-repeat;"{% endif %}>
  <div class="hero-inner">
    <span class="eyebrow">بوابتك العربية للمصارعة الحرة</span>
    <h1 class="hero-title{% if isNews %} news-hero-title{% endif %}">
      {% if isNews %}
        {{ title }}
      {% else %}
        {% if headline %}
          {{ headline | arabicShowName | stripDate }}
        {% elif title %}
          {% if "عرض" in title or "تغطية" in title or "ملخص" in title %}
            {{ title | arabicShowName | stripDate }}
          {% else %}
            عرض {{ title | arabicShowName | stripDate }} مترجم
          {% endif %}
        {% else %}
          عروض المصارعة المترجمة
        {% endif %}
        {% if event_date or date %}
        <span class="u">
          {% if event_date %}
            بتاريخ {{ event_date | date }}
          {% elif date %}
            بتاريخ {{ date | date }}
          {% endif %}
        </span>
        {% endif %}
      {% endif %}
    </h1>
  </div>
</div>

<main>
  <div class="post-wrap reveal">
    <a class="back-link" href="/">→ رجوع للرئيسية</a>
    <div class="post-meta-bar">
      {% if federation %}<span class="post-fed cat-{{ federation | lower }}">{{ federation }}</span>{% endif %}
      {% if title and headline and title != headline %}<span class="post-ep-name">{{ title }}</span>{% endif %}
      {% if duration %}<span class="post-meta-tag"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-inline-end:5px; flex-shrink:0;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>{{ duration }}</span>{% endif %}
    </div>
    {% if not isNews %}
    <h2>{{ headline or title }}</h2>
    {% endif %}

    {% if image and isNews %}
    <img class="post-cover reveal" src="{% optImg image, 'https://images.unsplash.com/photo-1563844528129-067e06a638e5?w=800&auto=format&fit=crop' %}" alt="{{ title }}">
    {% endif %}

    {% if servers and servers.length %}
      {% if isShow %}
      <div class="quality-notice"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><span><strong>تنبيه:</strong> سيرفرات المشاهدة تُعيد ترميز الفيديو مما يقلل من جودته؛ لمشاهدته بجودته الأصلية يُنصح بتحميل العرض.</span></div>
      {% endif %}
      {% if servers.length > 1 %}
      <div class="server-tabs" id="serverTabs">
        {% for s in servers %}
        <button class="server-tab{% if loop.index0 == 0 %} active{% endif %}" data-src="{{ s.url }}">سيرفر {{ loop.index }} - جودة متوسطة</button>
        {% endfor %}
      </div>
      {% endif %}
      <div class="video-embed reveal">
        <iframe id="videoFrame" src="{{ servers[0].url }}" allowfullscreen></iframe>
      </div>
    {% endif %}

    {% set dlGroups = downloads | groupDownloadsByQuality(downloads_low, downloads_medium, downloads_high) %}
    {% if dlGroups.low.length or dlGroups.medium.length or dlGroups.high.length %}
    <div class="download-links reveal">
      <h3>روابط التحميل</h3>
      <div class="quality-grid">
        {% if dlGroups.low.length %}
        <button type="button" class="quality-btn" data-tier="low" data-modal="dlModalLow">
          <span class="quality-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
          <span class="quality-label">جودة منخفضة</span>
          <span class="quality-sub">480p</span>
        </button>
        {% endif %}
        {% if dlGroups.medium.length %}
        <button type="button" class="quality-btn" data-tier="medium" data-modal="dlModalMedium">
          <span class="quality-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
          <span class="quality-label">جودة متوسطة</span>
          <span class="quality-sub">720p</span>
        </button>
        {% endif %}
        {% if dlGroups.high.length %}
        <button type="button" class="quality-btn" data-tier="high" data-modal="dlModalHigh">
          <span class="quality-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
          <span class="quality-label">جودة عالية</span>
          <span class="quality-sub">1080p</span>
        </button>
        {% endif %}
      </div>
    </div>
    {% endif %}

    {% if program_name %}
      {% set nav = getEpisodeNav(program_name, page.url, collections.programsGrouped) %}
      {% if nav %}
        <div class="episodes-nav reveal">
          <div class="episodes-nav-head">
            <h3>
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              حلقات {{ nav.program.name }}
            </h3>
            <span class="episodes-count">{{ nav.program.episodes.length }} حلقة</span>
          </div>

          {% if nav.program.seasons.length > 1 %}
          <div class="season-tabs" id="seasonTabs">
            {% for season in nav.program.seasons %}
            <button type="button" class="season-tab{% if season.number == nav.activeSeason %} active{% endif %}" data-season="{{ season.number }}">
              {% if season.number %}الموسم {{ season.number }}{% else %}حلقات متفرقة{% endif %}
            </button>
            {% endfor %}
          </div>
          {% endif %}

          {% for season in nav.program.seasons %}
          <div class="episode-strip" data-season-panel="{{ season.number }}"{% if season.number != nav.activeSeason %} style="display:none;"{% endif %}>
            {% for ep in season.episodes %}
            <a href="{{ ep.url | cleanUrl }}" class="ep-pill{% if nav.currentIndex > -1 and ep.url == nav.program.episodes[nav.currentIndex].url %} active{% endif %}" title="{{ ep.headline or ep.title }}">
              <span class="ep-pill-num">{% if ep.episode %}{{ ep.episode }}{% else %}{{ loop.index }}{% endif %}</span>
            </a>
            {% endfor %}
          </div>
          {% endfor %}

          {% if nav.prevEp or nav.nextEp %}
          <div class="ep-nav-arrows">
            {% if nav.prevEp %}
            <a href="{{ nav.prevEp.url | cleanUrl }}" class="ep-nav-btn ep-nav-prev">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
              <span class="ep-nav-text">
                <span class="ep-nav-label">الحلقة السابقة</span>
                <span class="ep-nav-title">{{ nav.prevEp.headline or nav.prevEp.title }}</span>
              </span>
            </a>
            {% else %}
            <span class="ep-nav-btn ep-nav-prev disabled"></span>
            {% endif %}
            {% if nav.nextEp %}
            <a href="{{ nav.nextEp.url | cleanUrl }}" class="ep-nav-btn ep-nav-next">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              <span class="ep-nav-text">
                <span class="ep-nav-label">الحلقة التالية</span>
                <span class="ep-nav-title">{{ nav.nextEp.headline or nav.nextEp.title }}</span>
              </span>
            </a>
            {% else %}
            <span class="ep-nav-btn ep-nav-next disabled"></span>
            {% endif %}
          </div>
          {% endif %}
        </div>
        <script>
        (function(){
          var tabs = document.querySelectorAll('#seasonTabs .season-tab');
          var panels = document.querySelectorAll('[data-season-panel]');
          tabs.forEach(function(tab){
            tab.addEventListener('click', function(){
              tabs.forEach(function(t){ t.classList.remove('active'); });
              tab.classList.add('active');
              var season = tab.getAttribute('data-season');
              panels.forEach(function(p){
                p.style.display = (p.getAttribute('data-season-panel') === season) ? 'flex' : 'none';
              });
            });
          });
        })();
        </script>
      {% endif %}
    {% endif %}

    <div class="post-body reveal">
      {{ content | autoEmbedSocials | safe }}
    </div>

    {% if tags and tags.length %}
    <div class="post-tags reveal">
      <span class="tags-label">الوسوم:</span>
      {% for tag in tags %}
        {% if tag %}
        <a href="/tag/{{ tag | arabicSlug }}/" class="tag-pill">#{{ tag }}</a>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>
</main>

