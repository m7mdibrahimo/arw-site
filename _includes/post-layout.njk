<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
{% include "theme-init.njk" %}
{% include "adsense.njk" %}
<script>if(!['arab-wrestling.com','localhost','127.0.0.1'].includes(location.hostname)){location.replace('https://arab-wrestling.com'+location.pathname+location.search+location.hash);}</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2">
<link rel="icon" type="image/png" href="/favicon.png?v=2">
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2">
{% set pageTitle = headline or title %}
{% if page.inputPath and "content/shows" in page.inputPath %}{% set showSeoData = showSeo(headline, title, program_name, event_date, page.url, collections.library, description) %}{% set pageTitle = showSeoData.title %}{% set description = showSeoData.description %}{% endif %}
{% set isNostalgiaItem = (kind == 'nostalgia') or (page.inputPath and ("content/nostalgia" in page.inputPath)) or nostalgia_series or (page.url and page.url.startsWith('/nostalgia/')) %}
{% set isNews = (kind == 'news') or (page.inputPath and ("content/news" in page.inputPath)) or (page.url and page.url.startsWith('/news/')) %}
<title>{{ pageTitle }} | عرب راسلنج</title>
{% set baseDesc = description or (content | striptags | truncate(155)) or 'مشاهدة وتحميل عروض المصارعة مترجمة وآخر الأخبار والملخصات على عرب راسلنج.' %}
{% set metaDesc = baseDesc | truncate(160) %}
<meta name="description" content="{{ metaDesc }}">
{% if tags and tags.length %}
<meta name="keywords" content="{{ tags | join(', ') }}">
{% endif %}
<link rel="canonical" href="https://arab-wrestling.com{{ page.url | cleanUrl }}">
<link rel="alternate" type="application/rss+xml" title="عرب راسلنج - تغذية الأخبار RSS" href="https://arab-wrestling.com/feed.xml">

{% set schemaImage = (image | absUrl) if image else 'https://arab-wrestling.com/assets/logo.png' %}
{% set isVideoContent = (servers and servers.length) and not isNews %}
{% set pageUrl = 'https://arab-wrestling.com' + (page.url | cleanUrl) %}

<!-- Open Graph / Facebook -->
<meta property="og:type" content="article">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:title" content="{{ pageTitle }} | عرب راسلنج">
<meta property="og:description" content="{{ metaDesc }}">
<meta property="og:image" content="{{ schemaImage }}">
{% if image and not isNews %}{% optThumbMeta image %}{% endif %}
{# The short Arabic name for cards built in the browser («عرض الرو 28.09.2026 مترجم»), not the search title (INCIDENTS #287) #}
{% if not isNews and (headline or title) %}<meta name="arw-card-title" content="{{ (headline or title) | escape }}">{% endif %}
<meta property="og:image:secure_url" content="{{ schemaImage }}">
<meta property="og:site_name" content="عرب راسلنج">
<meta property="og:locale" content="ar_AR">
<meta property="article:published_time" content="{{ page.date.toISOString() }}">
<meta property="article:modified_time" content="{{ page.date.toISOString() }}">
{% if federation %}<meta property="article:section" content="{{ federation }}">{% endif %}
{% if tags and tags.length %}
{% for t in tags %}
<meta property="article:tag" content="{{ t }}">
{% endfor %}
{% endif %}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }} | عرب راسلنج">
<meta name="twitter:description" content="{{ metaDesc }}">
<meta name="twitter:image" content="{{ schemaImage }}">

<!-- JSON-LD Structured Data -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NewsArticle",
      "headline": "{{ pageTitle | escape }}",
      "description": "{{ (description or baseDesc) | escape }}",
      "image": {
        "@type": "ImageObject",
        "url": "{{ schemaImage }}",
        "caption": "{{ pageTitle | escape }}"
      },
      "datePublished": {{ page.date | jsonify | safe }},
      "dateModified": {{ page.date | jsonify | safe }},
      {% if federation %}"articleSection": "{{ federation }}",{% endif %}
      {% if tags and tags.length %}"keywords": "{{ tags | join(', ') | escape }}",{% endif %}
      {#- the show's program under every name people search it by — for search engines only, nothing on the page (owner) -#}
      {% set ldAbout = libraryProgramOf(page.url, collections.library) if page.url.startsWith('/shows/') else null %}
      {% if ldAbout %}"about": { "@type": "TVSeries", "name": "{{ ldAbout.name | escape }}", "url": "https://arab-wrestling.com/library/{{ ldAbout.slug }}/"{% if ldAbout.arName or ldAbout.aliases.length %}, "alternateName": [{% for a in ([ldAbout.arName] if ldAbout.arName else []).concat(ldAbout.aliases) %}"{{ a | escape }}"{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %} },{% endif %}
      "inLanguage": "ar",
      "isAccessibleForFree": "true",
      "speakable": {
        "@type": "SpeakableSpecification",
        "xpath": [
          "/html/head/title",
          "/html/head/meta[@name='description']/@content"
        ]
      },
      "author": {
        "@type": "{{ 'Person' if (author and author != 'عرب راسلنج') else 'Organization' }}",
        "name": "{{ (author or 'عرب راسلنج') | escape }}",
        "url": "https://arab-wrestling.com/about/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "عرب راسلنج",
        "url": "https://arab-wrestling.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://arab-wrestling.com/assets/logo.png"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ pageUrl }}"
      }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "الرئيسية",
          "item": "https://arab-wrestling.com/"
        },
        {% set sectionName = 'الأخبار' if page.url.startsWith('/news/') else ('نوستالجيا' if (page.url.startsWith('/nostalgia/') or isNostalgiaItem) else ('عروض المصارعة' if page.url.startsWith('/shows/') else 'ملخصات العروض')) %}
        {% set sectionUrl = '/news/' if page.url.startsWith('/news/') else ('/nostalgia/' if (page.url.startsWith('/nostalgia/') or isNostalgiaItem) else ('/shows/' if page.url.startsWith('/shows/') else '/recaps/')) %}
        {
          "@type": "ListItem",
          "position": 2,
          "name": "{{ sectionName }}",
          "item": "https://arab-wrestling.com{{ sectionUrl }}"
        },
        {% set ldFed = federation if (federation and not page.url.startsWith('/news/') and not isNostalgiaItem) else '' %}
        {% set ldProg = libraryProgramOf(page.url, collections.library) if page.url.startsWith('/shows/') else null %}
        {% set ldPos = 3 %}
        {% if ldFed %}{
          "@type": "ListItem",
          "position": {{ ldPos }},
          "name": "{{ ldFed }}",
          "item": "https://arab-wrestling.com/federation/{{ ldFed | lower }}/"
        },{% set ldPos = ldPos + 1 %}{% endif %}
        {% if ldProg %}{
          "@type": "ListItem",
          "position": {{ ldPos }},
          "name": "{{ ldProg.name }}",
          "item": "https://arab-wrestling.com/library/{{ ldProg.slug }}/"
        },{% set ldPos = ldPos + 1 %}{% endif %}
        {
          "@type": "ListItem",
          "position": {{ ldPos }},
          "name": "{{ pageTitle | escape }}",
          "item": "{{ pageUrl }}"
        }
      ]
    }
  ]
}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://platform.twitter.com" crossorigin>
<link rel="preconnect" href="https://syndication.twitter.com" crossorigin>
<link rel="preconnect" href="https://www.instagram.com" crossorigin>
<!-- سكريبتات تويتر/إنستجرام بتتحمل بس لو المقال فيه embed فعلي (شوف loadScript() تحت) -->
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800;900&family=Tajawal:wght@300;400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ asset('/assets/post-layout.css') }}">
<link rel="stylesheet" href="/assets/notif.css?v=20260922v1">
<link rel="stylesheet" href="/assets/features.css?v=20261005j">
<link rel="stylesheet" href="/assets/dark.css?v=20260926j">
</head>
<body class="post-layout">
<header>
  <nav class="nav" aria-label="التنقل الرئيسي">
    <a class="brand brand-lockup" href="/" aria-label="عرب راسلنج — الرئيسية"><span class="brand-mark"><img src="/assets/brand-logo.png?v=2" alt="" width="42" height="42"></span><span class="brand-words"><b class="brand-name">عرب <span>راسلنج</span></b><small class="brand-tag">المصارعة الحرة بالعربي</small></span></a>
    <form class="site-search" action="/search/" method="get">
      <input type="text" name="q" placeholder="اكتب ما تريد البحث عنه...">
      <button aria-label="بحث" type="submit"><svg fill="none" height="16" viewBox="0 0 24 24" width="16" xmlns="http://www.w3.org/2000/svg"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M21 21L16.65 16.65" stroke="currentColor" stroke-linecap="round" stroke-width="2"/></svg></button>
    </form>
    <ul id="navMenu">
      <li><a class="navlink" href="/">الرئيسية</a></li>
      <li><a class="navlink" href="/library/">مكتبة العروض</a></li>
      <li><a class="navlink{% if kind == 'show' and not fed and not isNostalgiaItem and not (page.url and page.url.startsWith('/nostalgia/')) %} active{% endif %}" href="/shows/">عروض المصارعة</a></li>
      <li><a class="navlink{% if kind == 'recap' %} active{% endif %}" href="/recaps/">ملخصات العروض</a></li>
      <li><a class="navlink{% if kind == 'news' or isNews %} active{% endif %}" href="/news/">الأخبار</a></li><li><a class="navlink{% if isNostalgiaItem or (page.url and page.url.startsWith('/nostalgia/')) %} active{% endif %}" href="/nostalgia/">نوستالجيا</a></li><li><a class="navlink" href="/apps/">تطبيقات الموقع</a></li>
      <li class="utility-row">
        <button aria-label="المفضلة وقائمة المشاهدة لاحقاً" class="theme-toggle bookmarks-btn" id="arwBookmarksBtn" type="button" title="المفضلة والمشاهدة لاحقاً">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
          <span class="bookmark-badge" id="arwBookmarkBadge" style="display:none;">0</span>
        </button>
        <button aria-label="تبديل الوضع الليلي" class="theme-toggle" id="arwThemeToggle" type="button">
          <svg class="icon-moon" fill="none" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79Z" fill="currentColor"/></svg>
          <svg class="icon-sun" fill="none" height="18" viewBox="0 0 24 24" width="18" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" fill="currentColor" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke="currentColor" stroke-linecap="round" stroke-width="2"/></svg>
        </button>
        <a class="navlink support-btn" href="/support/"><svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 21s-6.716-4.35-9.428-8.06C.688 10.2 1.2 6.6 4.1 4.9c2.3-1.35 5.1-.7 6.6 1.2.5.6.9 1.3 1.3 2 .4-.7.8-1.4 1.3-2 1.5-1.9 4.3-2.55 6.6-1.2 2.9 1.7 3.412 5.3 1.528 8.04C18.716 16.65 12 21 12 21Z"/></svg><span>ادعم الموقع</span></a>
        <a aria-label="قناة التليجرام" class="telegram-btn" href="https://t.me/arab_wrestling" target="_blank" rel="noopener" title="قناة التليجرام الرسمية">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M20.665 3.717l-17.73 6.837c-1.21.486-1.203 1.161-.222 1.462l4.552 1.42 10.532-6.645c.498-.303.953-.14.579.192l-8.533 7.701h-.002l-.002.001-.314 4.692c.46 0 .663-.211.921-.46l2.211-2.15 4.599 3.397c.848.467 1.457.227 1.668-.785l3.019-14.228c.309-1.239-.473-1.8-1.282-1.434z"/></svg>
        </a>
      </li>
    </ul>
  </nav>
</header>


{% set isNews = (page.inputPath and "content/news" in page.inputPath) %}
{% set isShow = (page.inputPath and ("content/shows" in page.inputPath or "content/nostalgia" in page.inputPath)) %}
{% set isRecap = (page.inputPath and "content/recaps" in page.inputPath) %}

<div class="hero" id="top"{% if image %} style="background: linear-gradient(180deg, rgba(10,12,16,.65) 0%, rgba(10,12,16,.82) 55%, var(--bg) 100%), url('{% optImg image, '' %}') center 30%/cover no-repeat;"{% endif %}>
  <div class="hero-inner">
    <span class="eyebrow">بوابتك العربية للمصارعة الحرة</span>
    <h1 class="hero-title{% if isNews %} news-hero-title{% endif %}">
      {% if isNews %}
        {{ title }}
      {% else %}
        {% if headline %}
          {{ headline | arabicShowName | stripDate }}
        {% elif title %}
          {% if "عرض" in title or "تغطية" in title or "ملخص" in title or "برنامج" in title or "مسلسل" in title %}
            {{ title | arabicShowName | stripDate }}
          {% else %}
            {{ show_type or "عرض" }} {{ title | arabicShowName | stripDate }} مترجم
          {% endif %}
        {% else %}
          عروض المصارعة المترجمة
        {% endif %}
        {% if event_date or date %}
        <span class="u">
          {% if event_date %}
            بتاريخ {{ event_date | date }}
          {% elif date %}
            بتاريخ {{ date | date }}
          {% endif %}
        </span>
        {% endif %}
      {% endif %}
    </h1>
  </div>
</div>

{% set shareUrl = "https://arab-wrestling.com" + page.url %}
{% set shareTitle = (title if isNews else (headline or title)) %}
{% macro shareBar(variant, shareUrl, shareTitle, isNews) %}
<div class="arw-share arw-share--{{ variant }}" data-url="{{ shareUrl }}" data-title="{{ shareTitle | escape }}">
  {% if variant == 'bottom' %}<span class="arw-share-label">{% if isNews %}شارك الخبر مع أصحابك{% else %}شارك العرض مع أصحابك{% endif %}</span>{% endif %}
  <div class="arw-share-btns">
    <a class="sh-wa" href="https://wa.me/?text={{ (shareTitle + ' ' + shareUrl) | urlencode }}" target="_blank" rel="noopener" aria-label="مشاركة على واتساب"><svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.56.93.95-3.47-.22-.36a9.4 9.4 0 0 1-1.44-5.01c0-5.2 4.23-9.43 9.44-9.43a9.37 9.37 0 0 1 6.67 2.77 9.37 9.37 0 0 1 2.76 6.67c0 5.2-4.24 9.43-9.45 9.43zm8.03-17.46A11.28 11.28 0 0 0 12.05.72C5.8.72.7 5.8.7 12.07c0 2 .52 3.95 1.52 5.67L.6 23.64l6.04-1.58a11.3 11.3 0 0 0 5.4 1.38h.01c6.26 0 11.35-5.09 11.36-11.35 0-3.03-1.18-5.88-3.32-8.03z"/></svg>{% if variant == 'bottom' %}<span>واتساب</span>{% endif %}</a>
    <a class="sh-tg" href="https://t.me/share/url?url={{ shareUrl | urlencode }}&text={{ shareTitle | urlencode }}" target="_blank" rel="noopener" aria-label="مشاركة على تيليجرام"><svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor"><path d="M20.665 3.717l-17.73 6.837c-1.21.486-1.203 1.161-.222 1.462l4.552 1.42 10.532-6.645c.498-.303.953-.14.579.192l-8.533 7.701-.314 4.692c.46 0 .663-.211.921-.46l2.211-2.15 4.599 3.397c.848.467 1.457.227 1.668-.785l3.019-14.228c.309-1.239-.473-1.8-1.282-1.434z"/></svg>{% if variant == 'bottom' %}<span>تيليجرام</span>{% endif %}</a>
    <a class="sh-fb" href="https://www.facebook.com/sharer/sharer.php?u={{ shareUrl | urlencode }}" target="_blank" rel="noopener" aria-label="مشاركة على فيسبوك"><svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor"><path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07"/></svg>{% if variant == 'bottom' %}<span>فيسبوك</span>{% endif %}</a>
    <a class="sh-x" href="https://twitter.com/intent/tweet?url={{ shareUrl | urlencode }}&text={{ shareTitle | urlencode }}" target="_blank" rel="noopener" aria-label="مشاركة على إكس"><svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>{% if variant == 'bottom' %}<span>إكس</span>{% endif %}</a>
    <button type="button" class="sh-copy" aria-label="نسخ الرابط"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg><span class="sh-copy-text">{% if variant == 'bottom' %}نسخ الرابط{% endif %}</span></button>
    <button type="button" class="sh-native" aria-label="مشاركة"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>{% if variant == 'bottom' %}<span>مشاركة</span>{% endif %}</button>
  </div>
</div>
{% endmacro %}
<main>
  <div class="post-wrap reveal{% if not isNews and (page.url.startsWith('/shows/') or page.url.startsWith('/recaps/') or isNostalgiaItem) %} is-watch{% endif %}">
    {% if isNostalgiaItem %}
    <a class="back-link" href="/nostalgia/{% if nostalgia_series %}{{ nostalgia_series }}/{% endif %}">→ {% if nostalgia_series %}{% if series_type == 'program' or (nav and (nav.program.isProgram or nav.program.seriesType == 'program')) or (program_name and 'حلقات' in program_name) %}رجوع لمسار البرنامج{% else %}رجوع لمسار السلسلة{% endif %}{% else %}رجوع لقسم نوستالجيا{% endif %}</a>
    {% else %}
    {% set crumbSection = "الأخبار" if isNews else ("ملخصات العروض" if isRecap else "عروض المصارعة") %}
    {% set crumbHref = "/news/" if isNews else ("/recaps/" if isRecap else "/shows/") %}
    <nav class="arw-crumbs" aria-label="مسار التنقل">
      <a href="/">الرئيسية</a><span aria-hidden="true">‹</span>
      <a href="{{ crumbHref }}">{{ crumbSection }}</a>
      {% if federation %}<span aria-hidden="true">‹</span><a href="/federation/{{ federation | lower }}/">{{ federation }}</a>{% endif %}
      {% set crumbProg = libraryProgramOf(page.url, collections.library) if (not isNews and not isRecap) else null %}
      {% if crumbProg %}<span aria-hidden="true">‹</span><a href="/library/{{ crumbProg.slug }}/"><bdi>{{ crumbProg.name }}</bdi></a>{% endif %}
    </nav>
    {# one BreadcrumbList only: the one in <head> has the whole path (INCIDENTS #286) #}
    {% endif %}
    <div class="post-meta-bar">
      {% if isShow and not isNostalgiaItem %}<span class="post-type-badge {% if show_type == 'برنامج' %}kind-program{% else %}kind-show{% endif %}">{{ "عرض" if (show_type == 'عرض كامل' or not show_type) else show_type }}</span>{% endif %}
      {% if federation %}<span class="post-fed cat-{{ federation | lower }}">{{ federation }}</span>{% endif %}
      {% if title and headline and title != headline %}<span class="post-ep-name">{{ title }}</span>{% endif %}
      {% if duration %}<span class="post-meta-tag"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-inline-end:5px; flex-shrink:0;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>{{ duration }}</span>{% endif %}
      {% if isNews and date %}<span class="post-meta-tag"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-inline-end:5px; flex-shrink:0;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><time datetime="{{ (date | dateObj).toISOString() }}">{{ date | date }}</time></span>{% endif %}
      {% if isNews %}{% set readMin = content | readingMinutes %}<span class="post-meta-tag"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-inline-end:5px; flex-shrink:0;"><path d="M2 4h7a3 3 0 0 1 3 3v13a2 2 0 0 0-2-2H2z"/><path d="M22 4h-7a3 3 0 0 0-3 3v13a2 2 0 0 1 2-2h8z"/></svg>{% if readMin <= 1 %}دقيقة قراءة{% elif readMin == 2 %}دقيقتان قراءة{% else %}{{ readMin }} دقائق قراءة{% endif %}</span>{% endif %}
      {#- show / recap / nostalgia pages: the full Arabic title sits in this card with its badges (owner, 2026-10-07) -#}
      {% if not isNews %}<h2 class="pm-title">{{ headline or title }}</h2>{% endif %}
      <div class="post-bookmark-wrap">
        <button type="button" class="post-bookmark-btn" id="arwPostBookmarkBtn" data-url="{{ page.url }}" data-title="{% if isNews %}{{ title | escape }}{% else %}{{ (headline or title) | escape }}{% endif %}" data-image="{% optImg image, '' %}" data-kind="{{ kind }}" data-kindlabel="{% if kind == 'show' %}عرض{% elif kind == 'recap' %}ملخص{% else %}خبر{% endif %}" data-fed="{{ federation or '' }}">
          <svg class="bm-icon-empty" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
          <svg class="bm-icon-filled" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
          <span class="bm-btn-text">حفظ للمشاهدة لاحقاً</span>
        </button>
      </div>
    </div>

    {% if image and isNews %}
    <img class="post-cover reveal" src="{% optImg image, 'https://images.unsplash.com/photo-1563844528129-067e06a638e5?w=800&auto=format&fit=crop' %}" alt="{{ title }}">

    <!-- 🎬 ARW Reels Video Showcase -->
    <div id="arwReelShowcase" class="arw-reel-card reveal" style="display: none;">
      <div class="arw-reel-header">
        <div class="arw-reel-badge">
          <span class="arw-reel-dot"></span>
          <span>عرب راسلنج REELS</span>
        </div>
        <div class="arw-reel-hint">شاهد ملخص الخبر سريعاً ⚡</div>
      </div>
      <!-- The player is created only when this story has a reel: a <video> in every story's HTML made
           Google list them all as «video isn't on a watch page» (INCIDENTS #142) -->
      <div class="arw-reel-video-wrapper" id="arwReelVideoBox" data-poster="{% optImg image, '' %}"></div>
    </div>
    <script>
      (function checkReelAvailability() {
        var wrap = document.getElementById('arwReelShowcase');
        var box = document.getElementById('arwReelVideoBox');
        if (!wrap || !box) return;
        var slug = window.location.pathname.replace(/^\/news\//, '').replace(/\/+$/, '').replace(/\.html$/, '');
        if (!slug) return;
        fetch('/api/videos/check?slug=' + encodeURIComponent(slug))
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data && data.exists && data.videoUrl) {
              var vid = document.createElement('video');
              vid.id = 'arwReelVideo'; vid.controls = true; vid.playsInline = true; vid.preload = 'metadata';
              if (box.dataset.poster) vid.poster = box.dataset.poster;
              vid.src = data.videoUrl;
              box.appendChild(vid);
              wrap.style.display = 'block';
            }
          })
          .catch(function() {});
      })();
    </script>
    {% endif %}

    {% if servers and servers.length %}
      {% set servers = servers | playableServers(videoHosts, videoLinks) %}
      {% set firstEmbedUrl = (servers[0].url | toEmbedUrl) %}
      {% set firstMq = firstEmbedUrl | isMultiQuality %}
      {#- «غرفة التحكم»: one card at the column width, like the download box — the servers on the right, the player
          on the left (owner, 2026-10-06) -#}
      <section class="watch-deck is-idle{% if servers.length < 2 %} is-single{% endif %}" id="watchDeck" aria-label="المشاهدة أونلاين">
        <div class="wd-head">
          <h3>المشاهدة أونلاين</h3>
          <div class="player-actions wd-acts">
            <button type="button" class="player-action-btn player-reload-btn" id="playerReloadBtn" title="إعادة تشغيل المشغل عند انقطاع البث أو حدوث خطأ (اختصار: R)" aria-label="تحديث المشغل">
              <span class="reload-icon-wrap">
                <svg class="reload-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/></svg>
              </span>
              <span class="action-text">تحديث المشغل</span>
            </button>
            <button type="button" class="player-action-btn player-cinema-btn" id="playerCinemaBtn" title="تفعيل وضع السينما وإعتام الإضاءة (اختصار: T)" aria-label="وضع السينما">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/><circle cx="12" cy="12" r="4"/></svg>
              <span>وضع السينما</span>
            </button>
          </div>
        </div>
        <div class="wd-body">
          {% if servers.length > 1 %}
          <div class="wd-side">
            <div class="wd-list" id="serverTabs" role="tablist" aria-label="سيرفرات المشاهدة">
              {% for s in servers %}
              {% set mq = (s.url | toEmbedUrl) | isMultiQuality %}
              <button type="button" role="tab" aria-selected="{{ 'true' if loop.index0 == 0 else 'false' }}" class="srv-row{% if loop.index0 == 0 %} active{% endif %}{% if mq %} is-mq{% endif %}" data-srv="{{ (s.url | toEmbedUrl) | obfuscateUrl }}" data-srv-name="سيرفر {{ loop.index }}"{% if mq %} data-mq="1" title="سيرفر متعدد الجودات: اختر الجودة من إعدادات المشغّل"{% endif %}>
                <span class="srv-num">{{ loop.index }}</span>
                <span class="srv-name"><b>سيرفر {{ loop.index }}</b>{% if mq %}<span class="srv-mq">متعدد الجودات</span>{% endif %}</span>
                <span class="srv-state"><span class="s-ready">جاهز</span><span class="s-load">جارٍ التشغيل</span><span class="s-on">يعمل الآن</span></span>
              </button>
              {% endfor %}
            </div>
          </div>
          {% endif %}
          <div class="video-embed-container">
            <div class="video-embed" id="videoEmbedBox" data-init-srv="{{ firstEmbedUrl | obfuscateUrl }}">
              {#- the show's picture waits with a play button; nothing loads from the servers until it's pressed -#}
              <button type="button" class="wd-poster" id="wdPoster" aria-label="تشغيل الفيديو">
                {% if image %}<img src="{% optImg image, '' %}" alt="{{ (headline or title) | escape }}" decoding="async" fetchpriority="high">{% endif %}
                <span class="wd-play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 4.6v14.8a1 1 0 0 0 1.52.85l12.1-7.4a1 1 0 0 0 0-1.7L8.52 3.75A1 1 0 0 0 7 4.6Z"/></svg></span>
              </button>
              <div class="video-loader is-hidden" id="videoLoader">
                <div class="video-loader-spinner"></div>
                <div class="video-loader-status" id="videoLoaderStatus">جاري الاتصال بالسيرفر وتشغيل الفيديو...</div>
                <div class="video-loader-progress" aria-hidden="true"><span id="videoLoaderBar"></span></div>
                <div class="video-loader-fallback" id="videoLoaderFallback" style="display:none;">
                  <span>السيرفر يستغرق وقتاً طويلاً؟</span>
                  <button type="button" class="loader-switch-srv-btn" id="loaderNextSrvBtn">تجربة سيرفر آخر ⏭</button>
                </div>
              </div>
              <noscript>
                <p style="color:#fff;text-align:center;padding:40px 20px;">يرجى تفعيل JavaScript لمشاهدة العرض.</p>
              </noscript>
            </div>
          </div>
        </div>
        {% if isShow %}
        <p class="wd-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><span><b>تنبيه:</b> سيرفرات المشاهدة تُعيد ترميز الفيديو مما يقلل من جودته؛ لمشاهدته بجودته الأصلية يُنصح بتحميل العرض.</span></p>
        {% endif %}
      </section>
      <div class="cinema-backdrop" id="cinemaBackdrop"></div>
      <button type="button" class="cinema-exit-float" id="cinemaExitFloat" aria-label="إلغاء وضع السينما">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        <span>إلغاء وضع السينما (Esc)</span>
      </button>
    {% endif %}

    {% set dlGroups = downloads | groupDownloadsByQuality(downloads_low, downloads_medium, downloads_high) %}
    {% if dlGroups.low.length or dlGroups.medium.length or dlGroups.high.length %}
    <div class="download-links reveal" id="downloads">
      <h3>روابط التحميل</h3>
      <div class="quality-grid">
        {% if dlGroups.low.length %}
        <button type="button" class="quality-btn" data-tier="low" data-modal="dlModalLow">
          <span class="quality-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
          <span class="quality-label">جودة منخفضة</span>
          <span class="quality-sub">480p</span>
        </button>
        {% endif %}
        {% if dlGroups.medium.length %}
        <button type="button" class="quality-btn" data-tier="medium" data-modal="dlModalMedium">
          <span class="quality-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
          <span class="quality-label">جودة متوسطة</span>
          <span class="quality-sub">720p</span>
        </button>
        {% endif %}
        {% if dlGroups.high.length %}
        <button type="button" class="quality-btn" data-tier="high" data-modal="dlModalHigh">
          <span class="quality-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
          <span class="quality-label">جودة عالية</span>
          <span class="quality-sub">1080p</span>
        </button>
        {% endif %}
      </div>
    </div>
    {% endif %}

    {% if program_name %}
      {% set navPrograms = collections.recapsProgramsGrouped if isRecap else collections.programsGrouped %}
      {% set nav = getEpisodeNav(program_name, page.url, navPrograms) %}
      {% if nav %}
        {% set isNostalgiaItem = (page.inputPath and ("content/nostalgia" in page.inputPath)) or nostalgia_series or nav.program.isNostalgia %}
        {% set isProgram = (series_type == "program") or (nav.program.isProgram) or (nav.program.seriesType == "program") %}
        {% set isSeries = ((nav.program.mode == "series") and not isNostalgiaItem) or isProgram %}
        {% set nounSingle = "حلقة" if isSeries else "عرض" %}
        {% set nounPlural = "حلقات" if isSeries else "عروض" %}
        {% set isAnnual = isNostalgiaItem or (nav.program.seasons.length == 1 and nav.program.seasons[0].type == "annual") or (nav.program.seasons.length == 1 and nav.program.seasons[0].type == "nostalgia") %}
        <div class="episodes-nav reveal">
          <div class="episodes-nav-head">
            <h3>
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              {% if isNostalgiaItem or nav.program.isNostalgia %}
              {{ nav.program.name }}
              {% else %}
              {# the program's name as the library has it — «عروض WWE RAW» (owner, 2026-10-07) #}
              {% if isRecap %}ملخصات {% endif %}{{ nounPlural }} {{ nav.program.name }}
              {% endif %}
            </h3>
            {% set epCount = nav.program.episodes.length %}
            {% set countSingle = "حلقة" if isProgram else ("عرض" if isNostalgiaItem else ("ملخص" if isRecap else nounSingle)) %}
            {% set countPlural = "حلقات" if isProgram else ("عروض" if isNostalgiaItem else ("ملخصات" if isRecap else nounPlural)) %}
          </div>

          {% set showsWord = "حلقات" if isProgram else ("ملخصات" if isRecap else "عروض") %}
          {% set showWord = "حلقة" if isProgram else ("ملخص" if isRecap else "عرض") %}
          <div class="sx-list">
            {% for ep in nav.recent %}
            {% set isNow = nav.currentIndex > -1 and ep.url == nav.program.episodes[nav.currentIndex].url %}
            <a href="{{ ep.url | cleanUrl }}" class="sx-card{% if isNow %} is-now{% endif %}{% if ep.named %} is-named{% endif %}" title="{{ ep.headline or ep.title }}"{% if isNow %} aria-current="page"{% endif %}>
              <span class="sx-thumb">
                {% if ep.image %}<img src="{% optCard ep.image %}" alt="{{ ep.headline or ep.title }}" loading="lazy" decoding="async" width="320" height="180">{% else %}<span class="sx-thumb-empty">عرب راسلنج</span>{% endif %}
                {% if isNow %}<span class="sx-now">{{ "تشاهدها الآن" if isProgram else "تشاهده الآن" }}</span>{% endif %}
              </span>
              <span class="sx-body">
                {% if isSeries and not isNostalgiaItem %}
                <span class="sx-date">{{ ep.episodeWords }}</span>
                <span class="sx-meta sx-meta-en"><bdi>{{ ep.title or ep.year }}</bdi></span>
                {% elif ep.named %}
                <span class="sx-name"><bdi>{{ ep.fullName }}</bdi></span>
                {% if not ep.hasDateInName and ep.dayLabel %}<span class="sx-meta">{{ ep.dayLabel }} {{ ep.year }}</span>{% endif %}
                {% else %}
                <span class="sx-date">{{ ep.dayLabel }}</span>
                <span class="sx-meta sx-meta-en"><bdi>{{ ep.title or ep.year }}</bdi></span>
                {% endif %}
              </span>
            </a>
            {% endfor %}
          </div>

          {% if not isNostalgiaItem %}
          <a href="{{ nav.libraryHref }}" class="sx-all">جميع {{ "ملخصات" if isRecap else nounPlural }} {{ nav.program.name }} <span class="sx-all-n">({{ epCount }})</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></a>
          {% endif %}
        </div>
      {% endif %}
    {% endif %}

    <div class="post-body">
      {{ content | autoLinkWrestlingStars | autoEmbedSocials | safe }}

    </div>

    {% if source_url %}
    <p class="post-source reveal">المصدر: <a href="{{ source_url }}" target="_blank" rel="noopener noreferrer nofollow">{{ source_url | sourceName }}</a></p>
    {% endif %}

    {% if tags and tags.length %}
    <div class="post-tags reveal">
      <span class="tags-label">الوسوم:</span>
      {% for tag in tags %}
        {% if tag %}
        {% set tagUrl = tag | tagHref %}
        {% if tagUrl %}<a href="{{ tagUrl }}" class="tag-pill">#{{ tag }}</a>{% else %}<span class="tag-pill tag-pill-plain">#{{ tag }}</span>{% endif %}
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}


    {{ shareBar('bottom', shareUrl, shareTitle, isNews) }}

    {% if isNews %}
    {% set newerNews = collections.news | getPreviousCollectionItem(page) %}
    {% set olderNews = collections.news | getNextCollectionItem(page) %}
    {% if newerNews or olderNews %}
    <nav class="news-pn reveal" aria-label="التنقل بين الأخبار">
      {% if olderNews %}<a class="news-pn-item news-pn-prev" href="{{ olderNews.url }}"><span class="news-pn-label">→ الخبر السابق</span><span class="news-pn-title">{{ olderNews.data.title }}</span></a>{% else %}<span></span>{% endif %}
      {% if newerNews %}<a class="news-pn-item news-pn-next" href="{{ newerNews.url }}"><span class="news-pn-label">الخبر التالي ←</span><span class="news-pn-title">{{ newerNews.data.title }}</span></a>{% endif %}
    </nav>
    {% endif %}
    {% endif %}

    {% set relatedPosts = page.url | getRelatedPosts(tags, federation, collections.allContent, 4, program_name, event_date or page.date) %}
    {% if relatedPosts and relatedPosts.length %}
    <section class="related-posts-section reveal" aria-label="ذات صلة">
      <div class="related-posts-head">
        <h3 class="related-posts-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          ذات صلة
        </h3>
        <span class="related-posts-badge">مقترحة لك</span>
      </div>
      <div class="related-posts-grid">
        {% for rItem in relatedPosts %}
        {% set rThumb = rItem.data.image or rItem.data.poster or rItem.data.thumbnail or rItem.data.header_image %}
        <a href="{{ rItem.url }}" class="related-card">
          <div class="related-card-thumb">
            {% if rThumb %}
              <img src="{% optCard rThumb %}" alt="{{ rItem.data.title }}" loading="lazy" decoding="async" width="280" height="155">
            {% else %}
              <div class="related-card-placeholder">عرب راسلنج</div>
            {% endif %}
            {% if rItem.data.federation %}
              <span class="related-card-fed fed-{{ rItem.data.federation | lower }}">{{ rItem.data.federation }}</span>
            {% endif %}
            {% if rItem.kind == "show" or rItem.kind == "recap" %}
              <div class="related-play-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86a1 1 0 0 0-1.5.86z"/></svg>
              </div>
            {% endif %}
          </div>
          <div class="related-card-info">
            <div class="related-card-tags">
              {% if rItem.kind == "show" %}
                <span class="related-card-kind kind-show">عرض</span>
              {% elif rItem.kind == "recap" %}
                <span class="related-card-kind kind-recap">ملخص</span>
              {% else %}
                <span class="related-card-kind kind-news">خبر</span>
              {% endif %}
            </div>
            <h4 class="related-card-title">{{ rItem.data.title }}</h4>
            <div class="related-card-foot">
              <span class="related-card-date">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {{ (rItem.data.event_date or rItem.data.date) | date("YYYY/MM/DD") }}
              </span>
            </div>
          </div>
        </a>
        {% endfor %}
      </div>
    </section>
    {% endif %}
  </div>
</main>

{% macro dlModal(id, title, qualityLabel, items) %}
<div class="dl-modal-backdrop" id="{{ id }}">
  <div class="dl-modal" role="dialog" aria-modal="true" aria-label="{{ title }}">
    <div class="dl-modal-head">
      <h4>{{ title }}</h4>
      <button type="button" class="dl-modal-close" aria-label="إغلاق">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="dl-modal-body">
      {% for item in items %}
      {% set dlMq = item.url | isMultiQuality %}
      <a class="dl-site-card{% if dlMq %} is-mq{% endif %}" data-dl="{{ item.url | obfuscateUrl }}" href="#" target="_blank" rel="noopener noreferrer nofollow">
