{# Applies the saved theme BEFORE the first paint (it used to run at the end of <body>,
   so dark-mode readers saw the light page flash on every load). Keep it first in <head>. #}
<script>(function(){var t=null;try{t=localStorage.getItem('arw-theme');}catch(e){}if(t!=='dark'&&t!=='light'){try{var m=document.cookie.match(/(?:^|; )arw-theme=([^;]*)/);if(m)t=decodeURIComponent(m[1]);}catch(e){}}var d=document.documentElement;if(t==='dark')d.classList.add('arw-dark');d.classList.add('arw-am-on');try{var s=JSON.parse(localStorage.getItem('arw-member')||'null'),m=s&&s.token&&s.member;if(m)d.classList.add('arw-in');if(m&&(m.official||Number(m.premium)>Date.now()))d.classList.add('arw-is-prem');}catch(e){}})();</script>
{# The header as it ends up, from the first paint (owner 2026-10-15: the old night-mode and saved-list buttons showed for a
   moment before the script moved them into the member's menu): they're hidden at once, the member's button has its place
   kept, and «العضوية المميزة» never shows to a member who already has it. #}
<style>html.arw-dark,html.arw-dark body{background-color:#07090d;color-scheme:dark}
html.arw-am-on header #navMenu #arwThemeToggle,html.arw-am-on header #navMenu #arwBookmarksBtn,html.arw-is-prem .premium-btn,html:not(.arw-in) .arw-cm-form{display:none!important}
html.arw-am-on header #navMenu li.utility-row:not(:has(.arw-acct-btn))::before{content:"";order:2;flex:none;width:36px;height:36px;border-radius:50%;border:1px solid var(--line,#e6e0d4);background:var(--card,#fff);box-sizing:border-box}
@media (max-width:1150px){html.arw-am-on header #navMenu li.utility-row:not(:has(.arw-acct-btn))::before{order:1}}
@media (max-width:768px),(orientation:landscape) and (max-height:550px),(max-height:500px){html.arw-am-on header #navMenu li.utility-row:not(:has(.arw-acct-btn))::before{width:38px;height:38px}html header #navMenu li.utility-row:not(:has(.arw-search-toggle))::after{content:"";order:0;flex:none;width:38px;height:38px;border-radius:50%;border:1px solid var(--line,#e6e0d4);background:var(--card,#fff);box-sizing:border-box}}</style>
