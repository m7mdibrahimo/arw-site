# Cloudflare Pages Security & Encryption Headers
# Multi-layered protection against clickjacking, MIME sniffing, XSS, and data interception

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  X-XSS-Protection: 1; mode=block

# Always checked with the server (fresh news on every visit), but without no-store:
# no-store made browsers re-download the whole homepage on «back» (no back/forward cache).
/
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

# Site icons: every page asks for them; links carry ?v=N, so bump N when the icon changes.
/favicon.svg
  Cache-Control: public, max-age=2592000

/favicon.png
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

# The panel page is always fresh; its code and style live in a folder named after the build
# (/admin/<build>/...), so a new build is a new address and the old files can be kept a year.
/admin/
  Cache-Control: no-cache, must-revalidate, max-age=0

/admin/index.html
  Cache-Control: no-cache, must-revalidate, max-age=0

/admin/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate, max-age=0

/admin/:build/*
  Cache-Control: public, max-age=31536000, immutable

/studio-data.json
  Cache-Control: no-cache, must-revalidate, max-age=0

/studio-library.json
  Cache-Control: no-cache, must-revalidate, max-age=0

/build.json
  Cache-Control: no-store
  X-Robots-Tag: noindex

/img-cache.json
  Cache-Control: no-cache, must-revalidate, max-age=0
  X-Robots-Tag: noindex

/content/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
  X-Content-Type-Options: nosniff

/img/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/assets/downloads/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff

/en/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
  Cache-Control: public, max-age=1800

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/news-sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=1800

